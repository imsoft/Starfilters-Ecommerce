---
import { GUIA_IMAGENES, type ZonaImagen } from "@/lib/image-guidelines";

// Aviso con el tamaño recomendado para cada zona donde se suben imágenes.
// Antes no había ninguno (salvo una línea en el blog, con una medida que no
// correspondía a cómo se muestra), así que se subían fotos de 391 px que en
// pantalla se veían pixeladas.
interface Props {
  zona: ZonaImagen;
  class?: string;
}

const { zona, class: clase = "" } = Astro.props;
const guia = GUIA_IMAGENES[zona];
---

<div class={`rounded-md border border-blue-200 bg-blue-50 p-3 ${clase}`}>
  <div class="flex gap-2">
    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M18 10A8 8 0 11 2 10a8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
        clip-rule="evenodd"
      />
    </svg>
    <div class="text-sm text-blue-900">
      <p>
        <span class="font-semibold">Tamaño recomendado: {guia.medidas}</span>
        <span class="text-blue-800"> — {guia.forma}.</span>
      </p>
      {guia.nota && <p class="mt-1 text-xs text-blue-800">{guia.nota}</p>}
    </div>
  </div>
</div>
