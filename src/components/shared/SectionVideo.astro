---
import { getLangFromUrl } from "@/i18n/utils";
import VideoSection from "@/components/shared/VideoSection.astro";

interface Props {
  videoId: string;
  videoTitle: string;
  heading?: string;
  // Las páginas alternan fondo azul claro / blanco sección a sección; según
  // dónde caiga el video, necesita uno u otro para no romper la secuencia.
  background?: 'tinted' | 'plain';
}

const lang = getLangFromUrl(Astro.url);
const {
  videoId,
  videoTitle,
  heading = lang === 'en' ? 'See our work' : 'Conoce nuestros proyectos',
  background = 'tinted',
} = Astro.props;

const bgClass = background === 'plain' ? 'bg-background' : 'bg-primary/10';
---

<div class={`${bgClass} py-16 border-t border-border`}>
  <div class="mx-auto max-w-4xl px-6 lg:px-8">
    <h2 class="text-center text-3xl font-bold text-foreground sm:text-4xl mb-8">
      {heading}
    </h2>
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <VideoSection videoId={videoId} title={videoTitle} noPadding={true} />
    </div>
  </div>
</div>
