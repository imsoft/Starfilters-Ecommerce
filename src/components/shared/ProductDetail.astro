---
import WebsiteLayout from "@/layouts/websiteLayout.astro";
import SEO from "@/components/shared/SEO.astro";
import LazyImage from "@/components/shared/LazyImage.astro";
import { getActiveProducts, getProductsByFilterCategory } from "@/lib/product-service";
import { getProductPlaceholderImage } from "@/lib/image-utils";
import type { Product } from "@/lib/database";
import { getProductImages } from "@/lib/database";
import { getProductVariants, getCategoryById, getChildCategories } from "@/lib/filter-category-service";
import type { FilterCategoryVariant } from "@/lib/filter-category-service";
import { generateProductKeywords, generateProductSchema, generateBreadcrumbSchema, extractTextFromHTML } from "@/lib/seo-utils";
import { getExchangeRate } from "@/lib/currency-service";
import { getBindInventoryByCode } from "@/lib/bind";
import { getProductName, getProductDescription, getProductCategory, getProductPriceAndCurrency, formatPriceByCurrency, getCategoryName } from "@/lib/i18n-helpers";
import { getWhatsAppNumber } from "@/lib/site-settings-service";

// Vista de detalle de producto compartida por /product/[id] y /en/product/[id],
// para que ambos idiomas tengan exactamente el mismo diseño. La página se
// encarga de buscar el producto y de redirigir si no existe; aquí solo se
// renderiza.
interface Props {
  product: Product;
  lang: 'es' | 'en';
}
const { product, lang } = Astro.props;

const isEn = lang === 'en';
// Prefijos de ruta por idioma (la tienda en español vive en /productos y la
// inglesa en /en/products).
const homeHref = isEn ? '/en' : '/';
const productsHref = isEn ? '/en/products' : '/productos';
const productHref = (id: string) => (isEn ? `/en/product/${id}` : `/product/${id}`);

const t = {
  home: isEn ? 'Home' : 'Inicio',
  products: isEn ? 'Products' : 'Productos',
  buyAt: isEn ? 'Buy at Star Filters' : 'Comprar en Star Filters',
  image: isEn ? 'image' : 'imagen',
  efficiency: isEn ? 'Efficiency' : 'Eficiencia',
  efficiencyClass: isEn ? 'EN1822 Class:' : 'EN1822 Clase:',
  characteristics: isEn ? 'Characteristics' : 'Características',
  applications: isEn ? 'Applications' : 'Aplicaciones',
  benefits: isEn ? 'Benefits' : 'Beneficios',
  typicalInstallation: isEn ? 'Typical Installation' : 'Instalación Típica',
  airFlow: isEn ? 'Air Flow' : 'Flujo de Aire',
  initialDp: isEn ? 'Initial ΔP' : 'ΔP Inicial',
  finalDp: isEn ? 'Recommended Final ΔP' : 'ΔP Final Recomendada',
  quantity: isEn ? 'Quantity:' : 'Cantidad:',
  addToCart: isEn ? 'Add to Cart' : 'Agregar al Carrito',
  requestQuote: isEn ? 'Request a formal quote' : 'Solicitar cotización formal',
  relatedProducts: isEn ? 'Related Products' : 'Productos Relacionados',
};

// Obtener variantes de categoría (tamaños) desde filter_category_variants
let categoryVariants: FilterCategoryVariant[] = [];
if (product.filter_category_id) {
  try {
    // Tamaños de ESTE producto (antes se traían los de toda la categoría y
    // se mezclaban los de productos distintos)
    categoryVariants = await getProductVariants(product.id, product.filter_category_id);
    // Solo mostrar variantes activas
    categoryVariants = categoryVariants.filter(v => v.is_active);
  } catch (error) {
    console.error('Error obteniendo variantes de categoría:', error);
  }
}

// Obtener variantes relacionadas (otros productos con el mismo filter_category_id) para productos relacionados
let relatedVariants: Product[] = [];
if (product.filter_category_id) {
  try {
    const allVariants = await getProductsByFilterCategory(product.filter_category_id);
    // Excluir el producto actual y solo mostrar activos
    relatedVariants = allVariants.filter(p => p.uuid !== product.uuid && p.status === 'active');
  } catch (error) {
    console.error('Error obteniendo variantes relacionadas:', error);
  }
}

// Cómo llamar al selector: en los filtros la variante es una medida, pero en
// manómetros o equipos es un modelo ("Digital - Rango 0 - 30 pascales"), y
// "Tamaño nominal / Tamaño real" no describía eso. Si ninguna variante trae
// medida real, se trata como modelo.
const hayMedidaReal = categoryVariants.some((v) => v.real_size?.trim())
  || Boolean(product.real_size?.trim());
const etiquetaSelector = hayMedidaReal
  ? (isEn ? 'Nominal size / Actual size:' : 'Tamaño nominal / Tamaño real:')
  : (isEn ? 'Model:' : 'Modelo:');

// Migas de pan de la categoría: desde la ficha se podía volver a "Productos"
// pero no al listado de la categoría en la que venías (ej. todos los filtros),
// así que había que empezar de cero para ver productos parecidos.
const categoryTrail: Array<{ name: string; href: string }> = [];
let productCategory: Awaited<ReturnType<typeof getCategoryById>> = null;
let parentCategory: Awaited<ReturnType<typeof getCategoryById>> = null;
if (product.filter_category_id) {
  try {
    const cat = await getCategoryById(product.filter_category_id);
    productCategory = cat;
    if (cat) {
      if (cat.parent_id) {
        const parent = await getCategoryById(cat.parent_id);
        parentCategory = parent;
        if (parent?.slug) {
          categoryTrail.push({
            name: getCategoryName(parent, lang),
            href: `${productsHref}?category=${parent.slug}`,
          });
        }
      }
      if (cat.slug) {
        categoryTrail.push({
          name: getCategoryName(cat, lang),
          href: `${productsHref}?category=${cat.slug}`,
        });
      }
    }
  } catch (error) {
    console.error('Error obteniendo la categoría para las migas de pan:', error);
  }
}

// Disponibilidad real (BIND), para que Google no anuncie como agotado algo que
// sí hay: products.stock local casi siempre está en cero.
const codigosBind = [
  (product as any).bind_code,
  ...categoryVariants.filter((v) => v.bind_code).map((v) => v.bind_code as string),
]
  .filter(Boolean)
  .map((c) => String(c).trim().toUpperCase());

let hayExistencia = product.stock > 0;
if (codigosBind.length > 0) {
  const inventarioBind = await getBindInventoryByCode().catch(() => null);
  if (inventarioBind && codigosBind.some((c) => inventarioBind.has(c))) {
    hayExistencia = codigosBind.reduce((s, c) => s + (inventarioBind.get(c) ?? 0), 0) > 0;
  }
}

// Obtener nombres traducidos
const productName = getProductName(product, lang);
const productDesc = getProductDescription(product, lang);
const productCat = getProductCategory(product, lang);

// Obtener tasa de cambio actual (necesaria antes de calcular precios)
const exchangeRate = await getExchangeRate();

// Función para convertir precio USD a MXN
const convertPriceToMXN = (price: number, currency: string): number => {
  if (currency === 'USD') {
    return price * exchangeRate;
  }
  return price;
};

// Obtener precio y moneda según idioma
const { price: displayPrice, currency: displayCurrency } = getProductPriceAndCurrency(product, lang, exchangeRate);

// Si estamos en español y el producto está en USD, convertir a MXN
let finalPrice = displayPrice;
let finalCurrency = displayCurrency;
if (lang === 'es' && displayCurrency === 'USD') {
  finalPrice = convertPriceToMXN(displayPrice, 'USD');
  finalCurrency = 'MXN';
}

// Productos relacionados: primero los de la misma categoría de filtro y, si no
// llegan a tres, los de las categorías hermanas de la misma familia.
//
// Antes se comparaba el TEXTO de la categoría, que funcionaba solo porque todos
// los productos tenían "Filtros de Aire" escrito. Al sincronizar ese texto con
// la categoría real de cada uno, cada producto quedó con un texto distinto y la
// sección se vació.
const relatedProducts: Product[] = [];
const yaIncluidos = new Set<string>([product.uuid]);

const agregarRelacionados = (candidatos: Product[]) => {
  for (const p of candidatos) {
    if (relatedProducts.length >= 3) return;
    if (yaIncluidos.has(p.uuid) || p.status !== 'active') continue;
    yaIncluidos.add(p.uuid);
    relatedProducts.push(p);
  }
};

// 1. Misma categoría (relatedVariants ya excluye el producto actual)
agregarRelacionados(relatedVariants);

// 2. Categorías hermanas de la misma familia
if (relatedProducts.length < 3 && parentCategory) {
  try {
    const hermanas = await getChildCategories(parentCategory.id);
    for (const hermana of hermanas) {
      if (relatedProducts.length >= 3) break;
      if (hermana.id === product.filter_category_id) continue;
      agregarRelacionados(await getProductsByFilterCategory(hermana.id));
    }
    if (relatedProducts.length < 3) {
      agregarRelacionados(await getProductsByFilterCategory(parentCategory.id));
    }
  } catch (error) {
    console.error('Error obteniendo productos de categorías hermanas:', error);
  }
}

// 3. Último recurso: productos con la misma categoría escrita (productos sin
// categoría de filtro asignada)
if (relatedProducts.length === 0) {
  const allProducts = await getActiveProducts();
  agregarRelacionados(
    allProducts.filter((p) => getProductCategory(p, lang) === productCat)
  );
}

// Preparar productos relacionados con imágenes
const relatedProductsWithImages = await Promise.all(
  relatedProducts.map(async (p) => {
    const images = await getProductImages(p.id);
    const primaryImage = images.find(img => img.is_primary) || images[0];
    const pCat = getProductCategory(p, lang);
    const imageUrl = primaryImage?.image_url || getProductPlaceholderImage(pCat);
    const { price: pPrice, currency: pCurrency } = getProductPriceAndCurrency(p, lang, exchangeRate);
    return { 
      ...p, 
      imageUrl, 
      name: getProductName(p, lang), 
      category: pCat,
      price: pPrice,
      currency: pCurrency
    };
  })
);

// Obtener imágenes del producto desde la base de datos
const productImages = await getProductImages(product.id);
const primaryImage = productImages.find(img => img.is_primary)?.image_url || 
                     productImages[0]?.image_url || 
                     product.image_url ||
                     getProductPlaceholderImage(productCat);
const mainImage = primaryImage;

// Solo las imágenes reales del producto; si no hay ninguna, al menos la principal
const allImages = productImages.length > 0
  ? productImages.map(img => img.image_url)
  : [mainImage];

// Precio final según idioma (ya calculado arriba)
const productPriceFinal = finalPrice;

// Función para formatear precio según moneda
const formatPrice = (price: number, currency: 'MXN' | 'USD' = finalCurrency): string => {
  return formatPriceByCurrency(price, currency);
};

// WhatsApp de cotización con el nombre del producto pre-cargado
const waNumber  = (await getWhatsAppNumber()) || '523322569541';
const waMessage = lang === 'en'
  ? `Hi, I would like to request a quote for: ${productName}`
  : `Hola, me gustaría solicitar una cotización para: ${productName}`;
const quoteWhatsappUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;

// Generar datos SEO
const siteUrl = Astro.site?.href || Astro.url.origin;
const productKeywords = generateProductKeywords(product);
const productDescription = extractTextFromHTML(productDesc || '', 160);
const productSchema = generateProductSchema(product, siteUrl);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: t.home, url: isEn ? `${siteUrl}en` : siteUrl },
  { name: t.products, url: `${siteUrl}${productsHref.replace(/^\//, '')}` },
  ...categoryTrail.map((crumb) => ({
    name: crumb.name,
    url: `${siteUrl}${crumb.href.replace(/^\//, '')}`,
  })),
  { name: productName, url: `${siteUrl}${productHref(product.uuid).replace(/^\//, '')}` }
]);

// Función helper para parsear campos que pueden ser JSON o texto
function parseListField(field: string | null | undefined): string[] {
  if (!field) return [];

  // Intentar parsear como JSON
  try {
    let parsed = JSON.parse(field);

    // Manejar doble serialización
    if (Array.isArray(parsed)) {
      const result: string[] = [];
      for (const item of parsed) {
        if (typeof item === 'string') {
          try {
            const innerParsed = JSON.parse(item);
            if (Array.isArray(innerParsed)) {
              result.push(...innerParsed.filter((i: any) => typeof i === 'string' && i.trim()));
            } else {
              result.push(item.trim());
            }
          } catch {
            if (item.trim()) result.push(item.trim());
          }
        }
      }
      return result.filter(item => item);
    }

    // Si es string después de parsear
    if (typeof parsed === 'string') {
      return parsed.split('\n').filter(item => item && item.trim());
    }
  } catch {
    // No es JSON, tratar como texto plano
  }

  return field.split('\n').filter(item => item && item.trim());
}

// Formato "tamaño nominal / tamaño real" para opciones del select
function sizeOptionLabel(nominal: string | null | undefined, real: string | null | undefined): string {
  const n = nominal?.trim();
  const r = real?.trim();
  // Hay productos (manómetros, equipos) donde la variante es un modelo y solo
  // se llena un campo: mostrar "Modelo X / —" se leía como dato faltante.
  if (n && r) return `${n} / ${r}`;
  return n || r || '—';
}

// Preparar opciones del select de tamaños sin duplicados
interface SizeOption {
  value: string;
  label: string;
  price: number;
  currency: string;
  stock: number;
  name: string;
  image: string;
  id: number;
  variantId?: number;
  bindCode?: string | null;
  airFlow?: string | null;
  isCurrentProduct: boolean;
}

const sizeOptions: SizeOption[] = [];
const addedSizes = new Set<string>();

// Flujo de aire: siempre definido para la plantilla (producto o variante)
let currentProductAirFlow: string | null = (product as any).air_flow || null;

// Si hay variantes de categoría, usarlas como fuente principal
if (categoryVariants.length > 0) {
  // Primero, crear clave única para el producto actual
  const currentProductSizeKey = product.bind_code?.trim() || 
                                `${(product.nominal_size || '').trim()}_${(product.real_size || '').trim()}`;
  // Fuera del bucle: más abajo se usa para registrar el producto actual cuando
  // no coincide con ninguna variante. Estaba declarada dentro del for y esa
  // línea lanzaba ReferenceError (500 en la ficha). No se notaba mientras el
  // producto siempre aparecía entre las variantes de su categoría.
  const normalizedCurrentKey = currentProductSizeKey.toLowerCase();
  let currentProductAdded = false;
  // Flujo de aire: del producto (tabla products) o de la variante que coincida
  const currentProductVariantForAirFlow = product.bind_code 
    ? categoryVariants.find(v => v.bind_code && v.bind_code.trim().toLowerCase() === product.bind_code!.trim().toLowerCase())
    : null;
  currentProductAirFlow = (product as any).air_flow || currentProductVariantForAirFlow?.air_flow || null;

  for (const variant of categoryVariants) {
    // Crear clave única basada en bind_code o en nominal/real (normalizado)
    const variantSizeKey = (variant.bind_code?.trim() || '').toLowerCase() || 
                          `${(variant.nominal_size || '').trim().toLowerCase()}_${(variant.real_size || '').trim().toLowerCase()}`;
    
    const normalizedVariantKey = variantSizeKey.toLowerCase();
    
    // Verificar si esta variante es el producto actual
    const isCurrentProduct = (product.bind_code && variant.bind_code && 
                             product.bind_code.trim().toLowerCase() === variant.bind_code.trim().toLowerCase()) ||
                            (!product.bind_code && !variant.bind_code &&
                             normalizedCurrentKey === normalizedVariantKey);
    
    // Si es el producto actual y aún no lo hemos agregado, agregarlo primero
    if (isCurrentProduct && !currentProductAdded) {
      sizeOptions.unshift({
        value: product.uuid,
        label: sizeOptionLabel(product.nominal_size, product.real_size),
        price: productPriceFinal,
        currency: finalCurrency,
        stock: product.stock,
        name: productName,
        image: mainImage,
        id: product.id,
        airFlow: currentProductAirFlow,
        isCurrentProduct: true
      });
      addedSizes.add(normalizedVariantKey);
      currentProductAdded = true;
      continue; // No agregar esta variante de nuevo
    }
    
    // Evitar duplicados (incluyendo si ya agregamos el producto actual)
    if (addedSizes.has(normalizedVariantKey)) {
      continue;
    }
    
    // Buscar si hay un producto asociado a esta variante por bind_code
    const variantProduct = relatedVariants.find(p => 
      p.bind_code && variant.bind_code && 
      p.bind_code.trim().toLowerCase() === variant.bind_code.trim().toLowerCase()
    );
    
    let variantPrice = variant.price;
    let variantCurrency = variant.currency || 'MXN';
    
    // Si estamos en español y la variante está en USD, convertir a MXN
    if (lang === 'es' && variantCurrency === 'USD') {
      variantPrice = convertPriceToMXN(variant.price, 'USD');
      variantCurrency = 'MXN';
    } else if (lang === 'es' && variant.price_usd) {
      // Si hay precio USD, usar ese convertido
      variantPrice = convertPriceToMXN(variant.price_usd, 'USD');
      variantCurrency = 'MXN';
    }
    
    sizeOptions.push({
      value: variantProduct?.uuid || `variant-${variant.id}`,
      label: sizeOptionLabel(variant.nominal_size, variant.real_size),
      price: variantPrice,
      currency: variantCurrency,
      stock: variant.stock,
      name: variantProduct ? getProductName(variantProduct, lang) : productName,
      image: variantProduct?.image_url || mainImage,
      id: variantProduct?.id || product.id,
      variantId: variant.id,
      bindCode: variant.bind_code,
      airFlow: variant.air_flow || null,
      isCurrentProduct: false
    });
    
    addedSizes.add(normalizedVariantKey);
  }

  // Antes, si el producto no coincidía con ninguna de sus variantes se añadía
  // su propia fila como una opción más. Eso metía datos viejos del producto
  // (el manómetro digital ofrecía "Análogo - Rango 0 - 1 columna de agua",
  // heredado de cuando ambos manómetros compartían tabla). Teniendo variantes
  // propias, ellas son la lista completa.
} else {
  // Fallback: usar producto actual y productos relacionados (currentProductAirFlow ya definido arriba)
  const currentSizeKey = product.bind_code || 
                        `${product.nominal_size || ''}_${product.real_size || ''}`;
  if (currentSizeKey && !addedSizes.has(currentSizeKey)) {
    sizeOptions.push({
      value: product.uuid,
      label: sizeOptionLabel(product.nominal_size, product.real_size),
      price: productPriceFinal,
      currency: finalCurrency,
      stock: product.stock,
      name: productName,
      image: mainImage,
      id: product.id,
      airFlow: currentProductAirFlow,
      isCurrentProduct: true
    });
    addedSizes.add(currentSizeKey);
  }
  
  // Agregar productos relacionados
  for (const variant of relatedVariants) {
    const sizeKey = variant.bind_code || 
                   `${variant.nominal_size || ''}_${variant.real_size || ''}`;
    
    if (addedSizes.has(sizeKey)) {
      continue;
    }
    
    const { price: variantPrice, currency: variantCurrency } = getProductPriceAndCurrency(variant, lang, exchangeRate);
    let variantFinalPrice = variantPrice;
    let variantFinalCurrency = variantCurrency;
    if (lang === 'es' && variantCurrency === 'USD') {
      variantFinalPrice = convertPriceToMXN(variantPrice, 'USD');
      variantFinalCurrency = 'MXN';
    }
    const variantName = getProductName(variant, lang);
    
    sizeOptions.push({
      value: variant.uuid,
      label: sizeOptionLabel(variant.nominal_size, variant.real_size),
      price: variantFinalPrice,
      currency: variantFinalCurrency,
      stock: variant.stock,
      name: variantName,
      image: variant.image_url || mainImage,
      id: variant.id,
      isCurrentProduct: false
    });
    
    addedSizes.add(sizeKey);
  }
}

// Preparar datos técnicos
const efficiencyList = parseListField(product.efficiency);
const characteristicsList = parseListField(product.characteristics);
const applicationsList = parseListField(product.applications);
const benefitsList = parseListField(product.benefits);
---

<WebsiteLayout
  title={productName}
  seoTitle={`${productName} - ${t.buyAt}`}
  description={productDescription}
  keywords={productKeywords}
  ogImage={mainImage}
>
  <SEO
    slot="seo"
    title={productName}
    description={productDescription}
    ogType="product"
    ogImage={mainImage}
    ogImageAlt={productName}
    keywords={productKeywords}
    product={{
      price: product.price,
      currency: 'MXN',
      availability: hayExistencia ? 'in stock' : 'out of stock',
      brand: 'Star Filters'
    }}
  />
  
  <!-- Product Schema -->
  <script slot="seo" type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  
  <!-- Breadcrumb Schema -->
  <script slot="seo" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="bg-background">
    <!-- Breadcrumb -->
    <div class="mx-auto max-w-2xl px-4 pt-24 sm:px-6 lg:max-w-7xl lg:px-8">
      <nav class="mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-sm text-muted-foreground">
          <li>
            <a href={homeHref} class="hover:text-foreground transition-colors">{t.home}</a>
          </li>
          <li>
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </li>
          <li>
            <a href={productsHref} class="hover:text-foreground transition-colors">{t.products}</a>
          </li>
          {categoryTrail.map((crumb) => (
            <>
              <li>
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
              </li>
              <li>
                <a href={crumb.href} class="hover:text-foreground transition-colors">{crumb.name}</a>
              </li>
            </>
          ))}
          <li>
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </li>
          <li class="text-foreground font-medium">{productName}</li>
        </ol>
      </nav>
    </div>

    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
      <!-- Technical Specifications Section -->
      <div class="mx-auto grid max-w-2xl grid-cols-1 items-start gap-x-8 gap-y-16 px-4 py-8 sm:px-6 sm:py-12 lg:max-w-7xl lg:grid-cols-2 lg:px-8">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">{productName}</h2>
          <div class="mt-4" data-product-uuid={product.uuid} data-currency={finalCurrency} data-price-usd={product.price_usd || ''} data-nominal-size={product.nominal_size || ''} data-real-size={product.real_size || ''} data-category={productCat}>
            {/* Un solo precio, en la moneda del idioma y con el código a la
                vista: mostrar además el equivalente en la otra moneda con la
                tasa del día confundía más de lo que ayudaba. */}
            <p id="main-product-price" class="text-3xl tracking-tight text-foreground">
              {formatPrice(productPriceFinal, finalCurrency)}
            </p>
          </div>

          <!-- Descripción -->
          <div class="mt-6 text-base text-muted-foreground">
            <p>{productDesc}</p>
          </div>

          <dl class="mt-10 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2 lg:gap-x-8">
            {/* Eficiencia */}
            {efficiencyList.length > 0 && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.efficiency}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">
                  <ul class="list-disc list-inside space-y-1">
                    {efficiencyList.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  {product.efficiency_class && (
                    <p class="mt-2"><span class="font-medium">{t.efficiencyClass}</span> {product.efficiency_class}</p>
                  )}
                </dd>
              </div>
            )}

            {/* Características */}
            {characteristicsList.length > 0 && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.characteristics}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">
                  <ul class="list-disc list-inside space-y-1">
                    {characteristicsList.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}

            {/* Aplicaciones */}
            {applicationsList.length > 0 && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.applications}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">
                  <ul class="list-disc list-inside space-y-1">
                    {applicationsList.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}

            {/* Beneficios */}
            {benefitsList.length > 0 && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.benefits}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">
                  <ul class="list-disc list-inside space-y-1">
                    {benefitsList.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}

            {/* Instalación Típica (su propio cuadrito, abajo de Aplicaciones, columna izquierda) */}
            {product.typical_installation && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.typicalInstallation}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">{product.typical_installation}</dd>
              </div>
            )}

            {/* Flujo de Aire (su propio cuadrito, abajo de Beneficios, columna derecha, al lado de Instalación Típica) */}
            {currentProductAirFlow && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.airFlow}</dt>
                <dd class="mt-2 text-sm text-muted-foreground" id="air-flow-display">{currentProductAirFlow}</dd>
              </div>
            )}

            {/* ΔP Inicial */}
            {product.initial_pressure_drop && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.initialDp}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">{product.initial_pressure_drop}</dd>
              </div>
            )}

            {/* ΔP Final Recomendada */}
            {product.recommended_final_pressure_drop && (
              <div class="border-t border-border pt-4">
                <dt class="font-medium text-foreground">{t.finalDp}</dt>
                <dd class="mt-2 text-sm text-muted-foreground">{product.recommended_final_pressure_drop}</dd>
              </div>
            )}
          </dl>

          <!-- Formulario de compra -->
          <form class="mt-10 space-y-6">
            <!-- Tamaño y Cantidad en la misma fila -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Selector de Tamaño (nominal / real) -->
              {sizeOptions.length > 0 && (
                <div>
                  <label for="size-select" class="block text-sm font-medium text-foreground mb-2">
                    {etiquetaSelector}
                  </label>
                  <select
                    id="size-select"
                    name="size"
                    class="w-full rounded-md bg-background py-3 px-4 text-base text-foreground outline-1 -outline-offset-1 outline-border focus:outline-2 focus:-outline-offset-2 focus:outline-primary"
                  >
                    {sizeOptions.map((opt, idx) => (
                      <option 
                        key={idx}
                        value={opt.value} 
                        data-price={opt.price} 
                        data-currency={opt.currency}
                        data-name={opt.name}
                        data-image={opt.image}
                        data-id={opt.id}
                        data-variant-id={opt.variantId || ''}
                        data-bind-code={opt.bindCode || ''}
                        data-air-flow={opt.airFlow || ''}
                        selected={opt.isCurrentProduct}
                      >
                        {opt.label}
                      </option>
                    ))}
                  </select>
                </div>
              )}

              <!-- Cantidad (Input numérico) -->
              <div>
                <label for="quantity" class="block text-sm font-medium text-foreground mb-2">
                  {t.quantity}
                </label>
                <input
                  type="number"
                  id="quantity"
                  name="quantity"
                  min="1"
                  value="1"
                  class="w-32 rounded-md bg-background py-3 px-4 text-base text-foreground outline-1 -outline-offset-1 outline-border focus:outline-2 focus:-outline-offset-2 focus:outline-primary"
                />
              </div>
            </div>

            <!-- Botones de acción -->
            <div class="flex flex-col gap-3">
              <button
                type="button"
                id="add-to-cart-btn"
                class="flex w-full items-center justify-center rounded-md bg-primary px-8 py-3 text-base font-medium text-primary-foreground hover:bg-primary/90 focus:ring-2 focus:ring-primary focus:ring-offset-2 transition-colors"
              >
                {t.addToCart}
              </button>
              <a
                href={quoteWhatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2 rounded-md border-2 border-[#25D366] px-8 py-3 text-base font-medium text-[#25D366] hover:bg-[#25D366] hover:text-white transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                {t.requestQuote}
              </a>
            </div>
          </form>
        </div>
        <div class="order-first lg:order-none grid grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
          {allImages.map((src, i) => (
            <img
              key={i}
              alt={`${productName} - ${t.image} ${i + 1}`}
              src={src}
              class="rounded-lg bg-muted w-full object-cover"
            />
          ))}
        </div>
      </div>

      <!-- Productos relacionados -->
      {relatedProducts.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-24">
          <h2 id="related-heading" class="text-lg font-medium text-foreground">
            {t.relatedProducts}
          </h2>

          <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
            {relatedProductsWithImages.map((relatedProduct) => (
              <div class="group relative flex flex-col">
                <a href={productHref(relatedProduct.uuid)} class="block flex-shrink-0">
                  <div class="w-full h-80 overflow-hidden rounded-lg bg-muted">
                    <LazyImage
                      src={relatedProduct.imageUrl}
                      alt={relatedProduct.name}
                      class="h-full w-full object-cover object-center group-hover:opacity-75 transition-opacity"
                    />
                  </div>
                </a>
                <div class="mt-4 flex justify-between">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm text-foreground line-clamp-2 min-h-[2.5rem]">
                      <a href={productHref(relatedProduct.uuid)} class="hover:text-foreground transition-colors">
                        {relatedProduct.name}
                      </a>
                    </h3>
                    <p class="mt-1 text-sm text-muted-foreground">{relatedProduct.category}</p>
                  </div>
                  <p class="text-sm font-medium text-foreground ml-2 flex-shrink-0">
                    {formatPrice(relatedProduct.price)}
                  </p>
                </div>
                <div class="mt-auto pt-3">
                  <button
                    type="button"
                    class="relative z-10 w-full rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 transition-colors"
                    onclick={`event.stopPropagation(); addToCartFromProduct('${relatedProduct.uuid}', ${relatedProduct.id}, '${relatedProduct.name}', ${relatedProduct.price}, '${relatedProduct.imageUrl}', '${relatedProduct.category || ''}', '${relatedProduct.currency || displayCurrency}')`}
                  >
                    {t.addToCart}
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</WebsiteLayout>

<script>
  // Textos del cliente según el idioma de la URL (la vista es compartida por
  // /product/[id] y /en/product/[id]).
  const pageLang = window.location.pathname.startsWith('/en') ? 'en' : 'es';
  const isEnPage = pageLang === 'en';
  const msg = {
    minQty: isEnPage ? 'Quantity must be at least 1' : 'La cantidad debe ser al menos 1',
    soldOut: isEnPage
      ? 'This product is out of stock, please contact us for actual delivery times.'
      : 'Este producto está agotado, contáctanos para conocer los tiempos de entrega reales.',
    limitedStock: isEnPage
      ? "We don't have enough stock for that quantity. Contact us and we'll gladly help."
      : 'No tenemos inventario suficiente para esa cantidad. Cont\u00e1ctanos y con gusto te ayudamos.',
    outOfStock: isEnPage ? 'This product is out of stock' : 'Este producto está agotado',
    notEnough: isEnPage
      ? "We don't have enough stock for that quantity."
      : 'No tenemos inventario suficiente para esa cantidad.',
    added: (name: string, qty: number) => isEnPage
      ? `${name} added to cart (${qty})`
      : `${name} agregado al carrito (${qty})`,
    addedSingle: (name: string) => isEnPage
      ? `${name} added to cart`
      : `${name} agregado al carrito`,
    contactar: isEnPage ? 'Contact us' : 'Contáctanos',
    contactHref: isEnPage ? '/en/contact' : '/contacto',
  };

  // Estado actual del producto seleccionado
  let currentProduct = {
    uuid: '',
    id: 0,
    name: '',
    price: 0,
    currency: 'MXN',
    image: '',
    category: '',
    nominal_size: '',
    real_size: '',
    size_label: '',
    bind_code: undefined as string | undefined
  };

  // Con ClientRouter este módulo solo se evalúa una vez por sesión: la
  // inicialización debe repetirse en cada DOMContentLoaded (cubre la carga
  // inicial y el DOM nuevo tras cada navegación). Antes se usaba
  // DOMContentLoaded y el botón de carrito quedaba sin listener al llegar
  // navegando desde la tienda.
  function initProductPage() {
    const sizeSelect = document.getElementById('size-select') as HTMLSelectElement;
    const quantityInput = document.getElementById('quantity') as HTMLInputElement;
    const addToCartBtn = document.getElementById('add-to-cart-btn');

    // Evitar doble inicialización sobre el mismo DOM (el atributo desaparece
    // junto con el DOM viejo en cada navegación).
    if (!addToCartBtn || addToCartBtn.hasAttribute('data-cart-init')) return;
    addToCartBtn.setAttribute('data-cart-init', 'true');

    // Inicializar producto actual
    if (sizeSelect) {
      updateCurrentProduct(sizeSelect).then(() => {
        // Actualizar UI después de obtener datos
        updateQuantityInput();
        updateDisplayedPrice();
      });
      
      // Escuchar cambios en el select de tamaño
      sizeSelect.addEventListener('change', async () => {
        // Actualizar flujo de aire cuando cambia el tamaño
        const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
        const airFlow = selectedOption.getAttribute('data-air-flow') || '';
        const airFlowDisplay = document.getElementById('air-flow-display');
        if (airFlowDisplay) {
          if (airFlow) {
            airFlowDisplay.textContent = airFlow;
            // Asegurar que el contenedor padre sea visible
            const airFlowContainer = airFlowDisplay.closest('div');
            if (airFlowContainer) {
              airFlowContainer.style.display = 'block';
            }
          } else {
            // Ocultar si no hay flujo de aire
            const airFlowContainer = airFlowDisplay.closest('div');
            if (airFlowContainer) {
              airFlowContainer.style.display = 'none';
            }
          }
        }
        await updateCurrentProduct(sizeSelect);
        
        // Resetear cantidad a 1
        updateQuantityInput();
        // Actualizar precio mostrado
        updateDisplayedPrice();
      });
    } else {
      // Si no hay select de tamaño, usar datos del producto principal
      const productContainer = document.querySelector('[data-product-uuid]') as HTMLElement;
      if (productContainer) {
        currentProduct.uuid = productContainer.getAttribute('data-product-uuid') || '';
        currentProduct.currency = productContainer.getAttribute('data-currency') || 'MXN';
        // Intentar obtener tamaño del producto si está disponible
        currentProduct.category = productContainer.getAttribute('data-category') || '';
        const nominalSize = productContainer.getAttribute('data-nominal-size') || '';
        const realSize = productContainer.getAttribute('data-real-size') || '';
        if (nominalSize || realSize) {
          currentProduct.nominal_size = nominalSize;
          currentProduct.real_size = realSize;
          currentProduct.size_label = `${nominalSize || '—'} / ${realSize || '—'}`;
        }
      }
    }

    // Escuchar cambios en la cantidad
    if (quantityInput) {
      quantityInput.addEventListener('input', () => {
        const qty = parseInt(quantityInput.value) || 1;
        if (qty < 1) quantityInput.value = '1';
      });
    }

    // Agregar evento al botón de agregar al carrito
    addToCartBtn.addEventListener('click', handleAddToCart);

  }

  initProductPage();
  document.addEventListener('astro:page-load', initProductPage);

  async function updateCurrentProduct(sizeSelect: HTMLSelectElement) {
    const selectedOption = sizeSelect.options[sizeSelect.selectedIndex];
    const bindCode = selectedOption.getAttribute('data-bind-code') || '';

    // El inventario ya no viaja al navegador (ni en data-stock ni consultando
    // BIND): la disponibilidad se resuelve en el servidor al agregar al carrito
    // y al pagar, para no publicar cuántas piezas hay.

    // Extraer tamaño del texto de la opción (formato: "nominal / real")
    const sizeLabel = selectedOption.textContent || '';
    const sizeParts = sizeLabel.split(' / ');
    const nominalSize = sizeParts[0]?.trim() || '';
    const realSize = sizeParts[1]?.trim() || '';
    
    currentProduct = {
      uuid: selectedOption.value,
      id: parseInt(selectedOption.getAttribute('data-id') || '0'),
      name: selectedOption.getAttribute('data-name') || '',
      price: parseFloat(selectedOption.getAttribute('data-price') || '0'),
      currency: selectedOption.getAttribute('data-currency') || 'MXN',
      image: selectedOption.getAttribute('data-image') || '',
      category: document.querySelector('[data-category]')?.getAttribute('data-category') || '',
      nominal_size: nominalSize,
      real_size: realSize,
      size_label: sizeLabel,
      bind_code: bindCode || undefined
    };
  }

  function updateQuantityInput() {
    const quantityInput = document.getElementById('quantity') as HTMLInputElement;
    if (quantityInput) {
      quantityInput.value = '1';
    }
  }

  function updateDisplayedPrice() {
    const priceElement = document.getElementById('main-product-price');
    if (priceElement) {
      priceElement.textContent = formatPrice(currentProduct.price, currentProduct.currency);
    }
  }


  async function handleAddToCart() {
    const quantityInput = document.getElementById('quantity') as HTMLInputElement;
    const quantity = parseInt(quantityInput?.value || '1');

    if (quantity < 1) {
      showErrorNotification(msg.minQty);
      return;
    }

    // Obtener carrito actual para calcular cantidad total necesaria
    const cartData = localStorage.getItem('starfilters_cart');
    let cart = cartData ? JSON.parse(cartData) : { items: [], total: 0, itemCount: 0, currency: currentProduct.currency };

    // Buscar si el producto ya existe en el carrito
    const existingItemIndex = cart.items.findIndex((item: any) => item.uuid === currentProduct.uuid);
    const quantityInCart = existingItemIndex >= 0 ? cart.items[existingItemIndex].quantity : 0;
    const totalQuantityNeeded = quantityInCart + quantity;

    // Verificar stock antes de agregar
    try {
      let checkStockUrl = `/api/check-stock?uuid=${currentProduct.uuid}&quantity=${totalQuantityNeeded}`;
      if (currentProduct.bind_code) {
        checkStockUrl += `&bind_code=${encodeURIComponent(currentProduct.bind_code)}`;
      }
      
      const stockResponse = await fetch(checkStockUrl);
      const stockData = await stockResponse.json();

      if (!stockData.available) {
        showStockNotification(stockData.outOfStock ? msg.soldOut : msg.limitedStock);
        return;
      }
    } catch (error) {
      console.error('Error verificando stock:', error);
      // Continuar con la adición si falla la verificación (fallback)
    }

    // Si llegamos aquí, hay stock suficiente, proceder a agregar
    if (existingItemIndex >= 0) {
      cart.items[existingItemIndex].quantity += quantity;
      cart.items[existingItemIndex].price = currentProduct.price;
      cart.items[existingItemIndex].currency = currentProduct.currency;
      // Actualizar tamaño si cambió
      if (currentProduct.size_label) {
        cart.items[existingItemIndex].size = currentProduct.size_label;
      }
    } else {
      cart.items.push({
        uuid: currentProduct.uuid,
        product_id: currentProduct.id,
        name: currentProduct.name,
        price: currentProduct.price,
        currency: currentProduct.currency,
        quantity,
        image_url: currentProduct.image,
        category: currentProduct.category,
        size: currentProduct.size_label || undefined
      });
    }

    // Recalcular totales
    cart.total = cart.items.reduce((total: number, item: any) => total + (item.price * item.quantity), 0);
    cart.itemCount = cart.items.reduce((count: number, item: any) => count + item.quantity, 0);

    // Guardar en localStorage
    localStorage.setItem('starfilters_cart', JSON.stringify(cart));

    // Mostrar notificación
    showNotification(msg.added(currentProduct.name, quantity));

    // Disparar evento para actualizar navbar
    window.dispatchEvent(new CustomEvent('cartUpdated', { detail: cart }));
  }

  // Función para verificar stock en tiempo real
  async function checkStock(uuid: string, quantity: number): Promise<boolean> {
    try {
      const response = await fetch(`/api/check-stock?uuid=${uuid}&quantity=${quantity}`);
      const data = await response.json();
      
      if (!data.available) {
        showErrorNotification(data.outOfStock ? msg.outOfStock : msg.notEnough);
        return false;
      }
      
      return true;
    } catch (error) {
      console.error('Error verificando stock:', error);
      return true;
    }
  }

  // Función para formatear precio según moneda
  const currentLang = window.location.pathname.startsWith('/en') ? 'en' : 'es';
  const defaultCurrency = currentLang === 'en' ? 'USD' : 'MXN';
  
  function formatPrice(price: number, currency: string = defaultCurrency): string {
    // Mismo formato que el servidor: importe + código de moneda
    return new Intl.NumberFormat(
      currency === 'USD' ? 'en-US' : 'es-MX',
      {
        style: 'currency',
        currency: currency
      }
    ).format(price) + ' ' + currency;
  }

  function showNotification(message: string): void {
    const notification = document.createElement('div');
    notification.className = 'fixed top-20 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 transition-all duration-300';
    notification.innerHTML = `
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span>${message}</span>
      </div>
    `;
    document.body.appendChild(notification);

    setTimeout(() => {
      notification.style.opacity = '0';
      setTimeout(() => notification.remove(), 300);
    }, 3000);
  }

  function showStockNotification(message: string): void {
    const notification = document.createElement('div');
    notification.className = 'fixed top-20 right-4 bg-amber-600 text-white px-6 py-4 rounded-lg shadow-lg z-50 transition-all duration-300 max-w-sm';
    notification.innerHTML = `
      <div class="flex flex-col gap-3">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm">${message}</span>
        </div>
        <a href="${msg.contactHref}" class="inline-flex items-center justify-center gap-2 bg-white text-amber-700 font-semibold text-sm px-4 py-2 rounded-md hover:bg-amber-50 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          ${msg.contactar}
        </a>
      </div>
    `;
    document.body.appendChild(notification);

    setTimeout(() => {
      notification.style.opacity = '0';
      setTimeout(() => notification.remove(), 300);
    }, 8000);
  }

  function showErrorNotification(message: string): void {
    const notification = document.createElement('div');
    notification.className = 'fixed top-20 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 transition-all duration-300';
    notification.innerHTML = `
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        <span>${message}</span>
      </div>
    `;
    document.body.appendChild(notification);

    setTimeout(() => {
      notification.style.opacity = '0';
      setTimeout(() => notification.remove(), 300);
    }, 4000);
  }

  // Funciones globales para productos relacionados
  async function addToCartFromProduct(uuid: string, product_id: number, name: string, price: number, image_url: string, category: string, currency: string = 'MXN'): Promise<void> {
    const stockAvailable = await checkStock(uuid, 1);
    if (!stockAvailable) return;

    const cartData = localStorage.getItem('starfilters_cart');
    let cart = cartData ? JSON.parse(cartData) : { items: [], total: 0, itemCount: 0, currency: currency };

    const existingItemIndex = cart.items.findIndex((item: any) => item.uuid === uuid);

    if (existingItemIndex >= 0) {
      cart.items[existingItemIndex].quantity += 1;
    } else {
      cart.items.push({
        uuid,
        product_id,
        name,
        price,
        currency,
        quantity: 1,
        image_url,
        category
      });
    }

    cart.total = cart.items.reduce((total: number, item: any) => total + (item.price * item.quantity), 0);
    cart.itemCount = cart.items.reduce((count: number, item: any) => count + item.quantity, 0);

    localStorage.setItem('starfilters_cart', JSON.stringify(cart));
    showNotification(msg.addedSingle(name));
    window.dispatchEvent(new CustomEvent('cartUpdated', { detail: cart }));
  }

  (window as any).addToCartFromProduct = addToCartFromProduct;
</script>