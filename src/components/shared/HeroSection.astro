---
import Navbar from "./Navbar.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// El original pesaba 24 MB a 1080p/10 Mbps: en iPhone con datos móviles el
// hero se quedaba en gris esperando la descarga. Esta versión es 1280px, sin
// pista de audio (innecesaria en un loop de fondo) y con el índice al inicio
// (faststart), así arranca casi al instante: 1.1 MB.
const heroVideoSrc = "/videos/hero-720.mp4";
// Poster tomado del propio video: si el autoplay se bloquea (modo de bajo
// consumo de iOS, ahorro de datos), se ve el primer fotograma en vez de gris.
const heroPoster = "/videos/hero-poster.jpg";
---

<!-- svh en vez de vh: en iOS, 100vh mide la pantalla SIN las barras de
     Safari, así que el hero quedaba ~110px más alto que lo visible y la
     página se podía seguir desplazando después del footer.

     En móvil el texto va APILADO sobre el video, no encima: la tarjeta
     flotante tapaba casi todo el video en una pantalla angosta. En escritorio
     se conserva el video a sangre con la tarjeta flotando sobre él. -->
<div class="bg-background p-3 sm:p-4 lg:min-h-svh">
  <!-- Contenedor redondeado que envuelve TODO: navbar + video + tarjeta -->
  <div class="relative flex flex-col rounded-2xl overflow-hidden lg:min-h-[calc(100svh-2rem)]">

    <!-- Navbar: encima de todo -->
    <div class="relative z-20">
      <Navbar />
    </div>

    <!-- Texto. En móvil es un bloque sólido debajo del navbar; en escritorio
         vuelve a ser la tarjeta translúcida flotante abajo a la izquierda. -->
    <!-- pt-28 en móvil: el navbar es absolute (no ocupa lugar) y mide 104px,
         sin ese espacio el logo tapaba el título -->
    <div class="relative z-10 order-1 px-4 pt-28 pb-4 sm:px-6 lg:order-none lg:flex lg:flex-1 lg:items-end lg:px-16 lg:pb-16 lg:pt-0">
      <div class="hero-card w-full rounded-2xl bg-white p-6 shadow-sm sm:p-8 lg:max-w-lg lg:bg-white/40 lg:p-10 lg:shadow-xl lg:backdrop-blur-md">
        <h1 class="hero-title text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl leading-[1.08]">
          {t('hero.title')}
        </h1>
        <p class="hero-description mt-3 text-sm text-gray-600 leading-relaxed sm:mt-4 sm:text-lg">
          {t('hero.description')}
        </p>
        <div class="hero-cta mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap lg:mt-8">
          <a
            href={lang === 'en' ? '/en/filters' : '/filtros'}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary/90 transition-colors shadow-sm"
          >
            {t('hero.cta')}
          </a>
          <a
            href={lang === 'en' ? '/en/contact' : '/contacto'}
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-border px-6 py-3 text-sm font-semibold text-gray-900 hover:border-primary hover:text-primary transition-colors bg-white lg:border-white/80 lg:bg-white/30 lg:backdrop-blur-sm"
          >
            {t('hero.ctaSecondary')}
          </a>
        </div>
      </div>
    </div>

    <!-- Video: en móvil ocupa su propia franja debajo del texto; en escritorio
         pasa a ser el fondo de todo el hero. El poster va también como
         background porque iOS no siempre lo pinta. -->
    <div
      class="relative order-2 h-[58vw] max-h-[380px] w-full overflow-hidden rounded-2xl bg-cover bg-center lg:absolute lg:inset-0 lg:z-0 lg:order-none lg:h-full lg:max-h-none lg:rounded-none"
      style={`background-image: url('${heroPoster}')`}
    >
      <video
        id="hero-video"
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        poster={heroPoster}
      >
        <source src={heroVideoSrc} type="video/mp4" />
      </video>
      <div class="absolute inset-0 hidden bg-black/20 lg:block"></div>
    </div>

  </div>
</div>

<script>
  function ensureVideoPlays() {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (video) {
      // Intentar reproducir el video
      video.play().catch(err => {
        console.warn("Autoplay del video hero bloqueado por políticas del navegador:", err);
        // Fallback: reproducir en el primer clic o toque táctil en cualquier parte de la pantalla
        const playOnInteraction = () => {
          video.play().catch(e => console.error("Error al reproducir tras interacción:", e));
          document.removeEventListener('click', playOnInteraction);
          document.removeEventListener('touchstart', playOnInteraction);
        };
        document.addEventListener('click', playOnInteraction);
        document.addEventListener('touchstart', playOnInteraction);
      });
    }
  }

  // Ejecutar en la carga inicial de la página
  ensureVideoPlays();

  // Ejecutar después de transiciones de página (ClientRouter de Astro)
  document.addEventListener('astro:page-load', ensureVideoPlays);
</script>
