---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getHomeCaseStudies } from '@/lib/database';
import type { CaseStudy } from '@/lib/database';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

// La galería salía de portfolio_projects, una tabla aparte donde había que
// volver a capturar el mismo proyecto que ya estaba como caso de éxito. Ahora
// sale de los casos marcados con "mostrar en la página principal", así que
// cada tarjeta lleva a SU caso y no al listado completo.
let projects: CaseStudy[] = [];
try {
  projects = await getHomeCaseStudies();
} catch (error) {
  console.error('Error cargando los casos de éxito de la página principal:', error);
}

if (projects.length === 0) return;

// Carrusel automático (como los logos): la mitad del track debe ser más
// ancha que el viewport, así que con pocos proyectos se repite la lista
// hasta tener al menos 6 tarjetas.
const repeats = Math.max(1, Math.ceil(6 / projects.length));
const loopProjects = Array.from({ length: repeats }, () => projects).flat();
const scrollDuration = `${loopProjects.length * 6}s`;
import MarqueePause from "@/components/shared/MarqueePause.astro";
---

<section id={isEn ? 'project-gallery' : 'galeria-de-proyectos'} class="section-y bg-background scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 lg:px-6">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center mb-12">
      <h2 class="text-base/7 font-semibold text-primary">
        {isEn ? 'Our Work' : 'Nuestro Trabajo'}
      </h2>
      <p class="mt-2 text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl">
        {isEn ? 'Project Gallery' : 'Galería de Proyectos'}
      </p>
      <p class="mt-4 text-lg text-muted-foreground">
        {isEn
          ? 'A showcase of the cleanrooms and air systems we have designed, built, and validated.'
          : 'Una muestra de nuestros cuartos limpios y sistemas de aire que hemos diseñado, construido y validado.'}
      </p>
    </div>

  </div>

  <!-- Carrusel de proyectos (gira sola automáticamente, en cualquier pantalla) -->
  <div class="overflow-hidden">
    <div class="project-track flex items-stretch" data-marquee style={`animation-duration: ${scrollDuration}`}>
      {[...loopProjects, ...loopProjects].map((project) => {
        const title = (isEn && project.title_en) ? project.title_en : project.title;
        const description = (isEn && project.excerpt_en) ? project.excerpt_en : (project.excerpt || '');
        // Al caso concreto, no al listado: antes, sin link_url, todas las
        // tarjetas caían en "todos los proyectos".
        const portfolioHref = isEn
          ? `/en/success-cases/${project.slug}`
          : `/casos-de-exito/${project.slug}`;

        return (
          <div class="group relative flex flex-col flex-shrink-0 w-80 sm:w-96 mx-3 overflow-hidden rounded-2xl bg-white border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
            <!-- Imagen -->
            <div class="relative h-56 overflow-hidden">
              <img
                src={project.featured_image}
                alt={title}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Contenido -->
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg font-semibold text-foreground leading-snug mb-2">{title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed flex-1">{description}</p>

              <a
                href={portfolioHref}
                class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary/80 transition-colors"
              >
                {isEn ? 'View project' : 'Ver proyecto'}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .project-track {
    animation-name: scroll-projects;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    width: max-content;
  }

  /* Solo pausar con mouse real: en pantallas táctiles el :hover se queda
     "pegado" tras tocar la tarjeta y el carrusel ya no volvía a arrancar. */
  @media (hover: hover) and (pointer: fine) {
    .project-track:hover {
      animation-play-state: paused;
    }
  }

  @keyframes scroll-projects {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-track {
      animation: none;
    }
  }
</style>

<MarqueePause />
