---
import WebsiteLayout from "@/layouts/websiteLayout.astro";
import { DELIVERY_OPTIONS } from "@/lib/delivery-options";
import { pakkeConfigurado } from "@/lib/pakke";

// Con Pakke activo, la paquetería no tiene precio fijo: mostrar los $350
// de entrada anunciaría una tarifa que nunca se cobra.
const cotizaEnVivo = pakkeConfigurado();
import { getAuthenticatedUser } from "@/lib/auth-utils";
import { REGIMENES_FISCALES, USOS_CFDI, etiquetaSat } from "@/lib/sat-catalogs";

// Verify user is authenticated
const user = getAuthenticatedUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/en/login');
}
---

<WebsiteLayout title="Checkout">
  <div class="bg-background">
    <main class="section-pb mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:max-w-none">
        <h1 class="sr-only">Checkout</h1>
  
        <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 xl:gap-x-16">
<div>
            <div>
              <h2 class="mt-10 text-lg font-medium text-foreground">
                Contact Information
              </h2>
  
              <div class="mt-4">
                <label
                  for="email-address"
                  class="block text-sm/6 font-medium text-foreground"
                  >Email Address</label
                >
                <div class="mt-2">
                  <input
                    id="email-address"
                    type="email"
                    name="email-address"
                    value={user.email}
                    readonly
                    class="block w-full rounded-md bg-muted px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                  />
                </div>
              </div>
            </div>
  
            <!-- Delivery Method -->
            <div class="mt-10 border-t border-border pt-10">
              <h2 class="text-lg font-medium text-foreground">Delivery Method</h2>
              <div class="mt-4 space-y-3" id="delivery-options">
                {DELIVERY_OPTIONS.map((option) => (
                  <label class="relative flex cursor-pointer rounded-lg border border-border bg-background p-4 shadow-sm focus:outline-none has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary">
                    <input type="radio" name="delivery-method" value={option.value} class="sr-only" id={`delivery-${option.value}`} />
                    <span class="flex flex-1">
                      <span class="flex flex-col">
                        <span class="block text-sm font-medium text-foreground">{option.label['en']}</span>
                        <span class="mt-1 flex items-center text-sm text-muted-foreground">{option.days['en']}</span>
                        {option.address && (
                          <span class="mt-1 text-xs text-muted-foreground"><a href={option.address.mapUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">{option.address.text}</a></span>
                        )}
                        {option.note && (
                          <span class="mt-1 text-xs text-muted-foreground">{option.note['en']}</span>
                        )}
                      </span>
                    </span>
                    {option.value === 'paqueteria' && cotizaEnVivo ? (
                      <span class="ml-4 shrink-0 text-sm font-medium text-muted-foreground" id={`price-${option.value}`}>Calculated from your ZIP</span>
                    ) : option.cost === 0 ? (
                      <span class="ml-4 shrink-0 text-sm font-medium text-green-600">Free</span>
                    ) : (
                      <span class="ml-4 shrink-0 text-sm font-medium" id={`price-${option.value}`}>${option.cost.toFixed(2)}</span>
                    )}
                  </label>
                ))}
              </div>

              <!-- Live carrier rates (Pakke). Filled in when the customer picks
                   "Carrier Shipping" and types a postal code. If Pakke does not
                   answer, this stays hidden and the flat rate applies. -->
              <div id="pakke-panel" class="mt-4 hidden rounded-lg border border-border bg-muted/40 p-4">
                <p class="text-sm font-medium text-foreground">Available carriers</p>
                <p id="pakke-estado" class="mt-1 text-sm text-muted-foreground">
                  Enter your postal code to see the options and their prices.
                </p>
                <div id="pakke-opciones" class="mt-3 space-y-2"></div>
              </div>
            </div>

            <!-- Shipping Information (only for options that require an address) -->

<div class="mt-10 border-t border-border pt-10 hidden" id="shipping-info-section">
              <h2 class="text-lg font-medium text-foreground">
                Shipping Information
              </h2>

              <div class="mt-4 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4" id="shipping-address-fields">
                <div>
                  <label for="first-name" class="block text-sm/6 font-medium text-foreground">First Name</label>
                  <div class="mt-2">
                    <input
                      id="first-name"
                      type="text"
                      name="first-name"
                      value={user.firstName}
                      readonly
                      class="block w-full rounded-md bg-muted px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div>
                  <label for="last-name" class="block text-sm/6 font-medium text-foreground">Last Name</label>
                  <div class="mt-2">
                    <input
                      id="last-name"
                      type="text"
                      name="last-name"
                      value={user.lastName}
                      readonly
                      class="block w-full rounded-md bg-muted px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <label for="address" class="block text-sm/6 font-medium text-foreground">Address</label>
                  <div class="mt-2">
                    <input
                      id="address"
                      type="text"
                      name="address"
                      class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div>
                  <label for="city" class="block text-sm/6 font-medium text-foreground">City</label>
                  <div class="mt-2">
                    <input
                      id="city"
                      type="text"
                      name="city"
                      class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div>
                  <label for="state" class="block text-sm/6 font-medium text-foreground">State</label>
                  <div class="mt-2">
                    <input
                      id="state"
                      type="text"
                      name="state"
                      class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div>
                  <label for="postal-code" class="block text-sm/6 font-medium text-foreground">Postal Code</label>
                  <div class="mt-2">
                    <input
                      id="postal-code"
                      type="text"
                      name="postal-code"
                      class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div>
                  <label for="country" class="block text-sm/6 font-medium text-foreground">Country</label>
                  <div class="mt-2">
                    <input
                      id="country"
                      type="text"
                      name="country"
                      value="Mexico"
                      readonly
                      class="block w-full rounded-md bg-muted px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <label for="phone" class="block text-sm/6 font-medium text-foreground">Contact phone</label>
                  <div class="mt-2">
                    <input
                      id="phone"
                      type="tel"
                      name="phone"
                      autocomplete="tel"
                      placeholder="+52 33 1234 5678"
                      class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6"
                    />
                  </div>
                  <p class="mt-1.5 text-xs text-muted-foreground">So we can coordinate the delivery. Only used for this order.</p>
                </div>
              </div>
            </div>

            <!-- Billing details (optional) -->
            <div class="mt-10 border-t border-border pt-10" id="billing-section">
              <h2 class="text-lg font-medium text-foreground">Billing details</h2>
              <p class="mt-1 text-sm text-muted-foreground">Optional. Only if you need a tax invoice for this order.</p>

              <label class="mt-4 flex items-center gap-3 cursor-pointer">
                <input type="checkbox" id="wants-invoice" class="h-4 w-4 rounded border-border text-primary focus:ring-primary" />
                <span class="text-sm font-medium text-foreground">I need an invoice</span>
              </label>

              <div class="mt-4 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-4 hidden" id="billing-fields">
                <div class="sm:col-span-2">
                  <label for="billing-business-name" class="block text-sm/6 font-medium text-foreground">Legal name</label>
                  <div class="mt-2">
                    <input id="billing-business-name" type="text" name="billing-business-name" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6" />
                  </div>
                </div>

                <div>
                  <label for="billing-rfc" class="block text-sm/6 font-medium text-foreground">RFC</label>
                  <div class="mt-2">
                    <input id="billing-rfc" type="text" name="billing-rfc" maxlength="13" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground uppercase outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6" />
                  </div>
                </div>

                <div>
                  <label for="billing-postal-code" class="block text-sm/6 font-medium text-foreground">Tax postal code</label>
                  <div class="mt-2">
                    <input id="billing-postal-code" type="text" name="billing-postal-code" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6" />
                  </div>
                </div>

                <div>
                  <label for="billing-tax-regime" class="block text-sm/6 font-medium text-foreground">Tax regime</label>
                  <div class="mt-2">
                    <select id="billing-tax-regime" name="billing-tax-regime" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6">
                      <option value="">Select a tax regime</option>
                      {REGIMENES_FISCALES.map((opcion) => (
                        <option value={etiquetaSat(opcion)}>{etiquetaSat(opcion)}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div>
                  <label for="billing-cfdi-use" class="block text-sm/6 font-medium text-foreground">CFDI use</label>
                  <div class="mt-2">
                    <select id="billing-cfdi-use" name="billing-cfdi-use" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6">
                      <option value="">Select a CFDI use</option>
                      {USOS_CFDI.map((opcion) => (
                        <option value={etiquetaSat(opcion)}>{etiquetaSat(opcion)}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <div class="sm:col-span-2">
                  <label for="billing-email" class="block text-sm/6 font-medium text-foreground">Email for the invoice</label>
                  <div class="mt-2">
                    <input id="billing-email" type="email" name="billing-email" class="block w-full rounded-md bg-background px-3 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Confirm button -->
            <div class="mt-10 border-t border-border pt-10" id="confirm-section">
              <div id="confirm-button-wrapper">
                <button
                  type="button"
                  id="confirm-info-btn"
                  disabled
                  class="w-full bg-primary text-primary-foreground py-3 px-6 rounded-md hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed font-semibold text-base shadow-sm"
                >
                  Select a delivery method to continue
                </button>
                <p id="confirm-validation-msg" class="mt-2 text-sm text-red-600 hidden"></p>
              </div>

              <!-- Confirmed info summary (hidden initially) -->
              <div id="confirmed-info-summary" class="hidden">
                <div class="flex items-center justify-between mb-3">
                  <h3 class="text-sm font-semibold text-foreground flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Information confirmed
                  </h3>
                  <button type="button" id="edit-info-btn" class="text-sm text-primary hover:text-primary/80 font-medium underline">Edit</button>
                </div>
                <div id="confirmed-details" class="text-sm text-muted-foreground bg-muted/50 rounded-md p-3 space-y-1"></div>
              </div>
            </div>

            <!-- Payment -->
            <div class="mt-10 border-t border-border pt-10" id="payment-section">
              <h2 class="text-lg font-medium text-foreground">Payment</h2>
  
              <div class="mt-6">
                <div id="stripe-payment-form" class="space-y-4">
                  <!-- Locked initial state -->
                  <div id="payment-locked" class="p-6 bg-muted/30 border border-dashed border-border rounded-lg text-center">
                    <svg class="w-10 h-10 text-muted-foreground/50 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <p class="text-sm text-muted-foreground">Please confirm your shipping information first to continue with payment.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Resumen del pedido: única columna derecha, fija al hacer scroll -->
          <div class="mt-10 lg:mt-0">
            <div class="lg:sticky lg:top-24">
            <h2 class="mt-10 text-lg font-medium text-foreground">Order Summary</h2>

            <div class="mt-4 rounded-lg border border-border bg-background shadow-xs">
              <h3 class="sr-only">Items in your cart</h3>
              <ul role="list" class="divide-y divide-border" id="order-items-list">
                <!-- Items will be loaded dynamically -->
              </ul>

              <!-- Discount code -->
              <div class="border-t border-border px-4 py-6 sm:px-6">
                <label for="discount-code" class="block text-sm font-medium text-foreground mb-2">
                  Discount Code
                </label>
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="discount-code"
                    name="discount-code"
                    placeholder="Enter your code"
                    class="flex-1 rounded-md bg-background px-3 py-2 text-sm text-foreground outline-1 -outline-offset-1 outline-border placeholder:text-muted-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-primary uppercase"
                  />
                  <button
                    type="button"
                    id="apply-discount"
                    class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-50"
                  >
                    Apply
                  </button>
                </div>
                <div id="discount-message" class="mt-2 text-sm hidden"></div>
              </div>

              <dl class="space-y-6 border-t border-border px-4 py-6 sm:px-6" id="order-summary">
                <!-- Summary will be loaded dynamically -->
              </dl>
            </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
  
  <script>
    import {
      DELIVERY_OPTIONS,
      FREE_SHIPPING_THRESHOLD,
      getShippingCost,
      getDeliveryLabel,
      isPickupMethod,
    } from "@/lib/delivery-options";
    import type { DeliveryMethod } from "@/lib/delivery-options";
    // Function to get cart from localStorage (client-side)
    function getCartFromStorage() {
      try {
        const cartData = localStorage.getItem('starfilters_cart');
        if (cartData) {
          return JSON.parse(cartData);
        }
      } catch (error) {
        console.error('Error reading cart:', error);
      }
      return { items: [], total: 0, itemCount: 0 };
    }

    // Function to format price according to cart currency
    function formatPrice(price: number, currency: string = 'USD'): string {
      // Con el código de moneda visible: el símbolo $ no distingue pesos de
      // dólares y el sitio maneja los dos.
      return new Intl.NumberFormat(
        currency === 'USD' ? 'en-US' : 'es-MX',
        {
          style: 'currency',
          currency: currency
        }
      ).format(price) + ' ' + currency;
    }

    // Billing (optional): the checkbox only shows/hides the fields; none of
    // them is required and none of this blocks the payment.
    function initInvoiceToggle() {
      const checkbox = document.getElementById('wants-invoice') as HTMLInputElement;
      const fields = document.getElementById('billing-fields');
      if (!checkbox || !fields || checkbox.hasAttribute('data-invoice-init')) return;
      checkbox.setAttribute('data-invoice-init', 'true');
      checkbox.addEventListener('change', () => {
        fields.classList.toggle('hidden', !checkbox.checked);
      });
    }

    // Returns the captured tax data, or null when no invoice was requested
    // (or the box was ticked but nothing was filled in).
    function getBillingData() {
      const checkbox = document.getElementById('wants-invoice') as HTMLInputElement;
      if (!checkbox?.checked) return null;
      const val = (id: string) =>
        (document.getElementById(id) as HTMLInputElement)?.value.trim() || undefined;
      const billing = {
        businessName: val('billing-business-name'),
        rfc: val('billing-rfc')?.toUpperCase(),
        taxRegime: val('billing-tax-regime'),
        cfdiUse: val('billing-cfdi-use'),
        postalCode: val('billing-postal-code'),
        email: val('billing-email'),
      };
      return Object.values(billing).some(Boolean) ? billing : null;
    }

    // El sitio en inglés cobra en dólares (el servidor recibe currency=USD).
    // Las tarifas de envío están definidas en pesos, así que se convierten con
    // la tasa del día: así hay una sola lista de precios de envío.
    let tasaCambio = 17;
    const cargarTasaCambio = async () => {
      try {
        const res = await fetch('/api/exchange-rate');
        const data = await res.json();
        if (data.success && data.rate) tasaCambio = data.rate;
      } catch {
        // Si falla, se usa la tasa por defecto
      }
    };

    /** Rounds to cents avoiding binary error (1.005 → 1.01). */
    const aCentavos = (n: number) => Math.round((n + Number.EPSILON) * 100) / 100;

    /** Amount in pesos, the currency discount codes are defined in. */
    const aMXN = (monto: number, moneda?: string) =>
      moneda === 'USD' ? monto * tasaCambio : monto;

    /** Lleva un importe a la moneda elegida por el visitante */
    const aUSD = (monto: number, moneda?: string) => {
      const destino = monedaElegida();
      const origen = moneda === 'USD' ? 'USD' : 'MXN';
      if (origen === destino) return monto;
      return origen === 'USD' ? monto * tasaCambio : monto / tasaCambio;
    };

    /**
     * Moneda elegida por el visitante (selector del menú). Se lee de la cookie
     * para que el checkout cobre en la misma que muestran los precios.
     */
    const monedaElegida = (): 'MXN' | 'USD' => {
      const cookie = document.cookie.split('; ').find((c) => c.startsWith('moneda='));
      const valor = cookie?.split('=')[1]?.toUpperCase();
      return valor === 'USD' || valor === 'MXN' ? valor : 'USD';
    };


    // ---------------------------------------------------------------------
    // Cotización de paqueterías con Pakke.
    //
    // "Envío por paquetería" tenía una tarifa fija de $350 sin relación con el
    // destino ni el volumen. Ahora se piden las tarifas reales al escribir el
    // código postal. Si Pakke no contesta, `tarifaPakke` se queda en null y
    // todo el checkout sigue funcionando con la tarifa fija de siempre.
    // ---------------------------------------------------------------------
    let tarifaPakke: { serviceId: string; courierName: string; total: number } | null = null;
    let ultimoCpCotizado = '';
    /**
     * En qué punto va la cotización:
     *   sin-cp    falta el código postal → no se puede saber el precio todavía
     *   cargando  se está preguntando a Pakke
     *   ok        hay tarifa elegida
     *   fallback  Pakke no dio opciones → se cobra la tarifa fija de siempre
     */
    let estadoPakke: 'sin-cp' | 'cargando' | 'ok' | 'fallback' = 'sin-cp';

    // El botón de confirmar se pinta dentro de initCheckout y la cotización
    // corre fuera: no se veían entre sí. Sin este puente, al terminar de
    // cotizar se refrescaba el resumen (por eso el envío ya aparecía) pero el
    // botón se quedaba en "Calculando el envío…" y bloqueado para siempre.
    let refrescarBotonConfirmar: () => void = () => {};

    // Todo cambio de estadoPakke tiene que repintar el resumen Y el botón.
    const refrescarTrasCotizar = () => {
      renderOrderSummary();
      refrescarBotonConfirmar();
    };

    /** true cuando el envío aún no se puede cifrar y no debe mostrarse un monto. */
    function envioPorCalcular(method: string): boolean {
      return method === 'paqueteria' && (estadoPakke === 'sin-cp' || estadoPakke === 'cargando');
    }

    /** Costo de envío considerando la paquetería elegida por el comprador. */
    function costoEnvio(method: string, subtotalMXN: number): number {
      if (method === 'paqueteria') {
        if (estadoPakke === 'ok' && tarifaPakke) return tarifaPakke.total;
        // Sin código postal no se sabe cuánto cuesta: mostrar la tarifa fija
        // aquí seria anunciar un precio que cambia en cuanto la escriben.
        if (estadoPakke !== 'fallback') return 0;
      }
      return getShippingCost(method as DeliveryMethod, subtotalMXN);
    }

    function itemsParaCotizar() {
      const cart = getCartFromStorage();
      return (cart?.items || []).map((i: any) => ({
        uuid: i.uuid || i.id || i.productId,
        cantidad: i.quantity || 1,
      }));
    }

    /**
     * Plazo que promete el NOMBRE del servicio, en días hábiles, o null si no
     * promete ninguno ("Regular", "Express Saver", "Servicio Terrestre"…).
     */
    function plazoPrometido(serviceName: string): number | null {
      const n = String(serviceName || '').toLowerCase();
      if (/mismo d[ií]a|same[- ]?day/.test(n)) return 0;
      if (/d[ií]a siguiente|next[- ]?day|overnight|24\s*h/.test(n)) return 1;
      const m = n.match(/(\d+)\s*(d[ií]as?|days?)\b/);
      return m ? Number(m[1]) : null;
    }

    /**
     * Segunda línea de cada paquetería: "Servicio · tiempo".
     *
     * El nombre se oculta cuando promete un plazo que el estimado de Pakke no
     * respalda. Pasa hoy con 99M, que se vende como "Día siguiente" mientras
     * Pakke estima 3-5 días hábiles para ese mismo registro: quien compra
     * esperando mañana y recibe en cinco reclama a Star Filters, no a Pakke.
     *
     * Se tolera un día de diferencia porque el estimado incluye la recolección
     * en el almacén: los servicios exprés de DHL y FedEx prometen un día y
     * estiman dos (recolección + entrega), y ahí el nombre sí cuadra.
     *
     * Los nombres que no prometen plazo nunca se ocultan: no hay nada que
     * contradecir y sirven para distinguir dos servicios de la misma
     * paquetería (los dos DHL salen al mismo precio).
     */
    const DIAS_DE_RECOLECCION = 1;

    function detallePaqueteria(o: any): string {
      const estimado = Number(o.diasEstimados);
      const prometido = plazoPrometido(o.serviceName);
      const contradice =
        prometido !== null &&
        Number.isFinite(estimado) &&
        estimado > prometido + DIAS_DE_RECOLECCION;

      const partes = contradice ? [o.diasTexto] : [o.serviceName, o.diasTexto];
      return partes.map((t) => String(t || '').trim()).filter(Boolean).join(' · ');
    }

    async function cotizarPaqueteria(forzar = false) {
      const panel = document.getElementById('pakke-panel');
      const estado = document.getElementById('pakke-estado');
      const lista = document.getElementById('pakke-opciones');
      if (!panel || !estado || !lista) return;

      if (getSelectedDeliveryMethod() !== 'paqueteria') {
        panel.classList.add('hidden');
        return;
      }
      panel.classList.remove('hidden');

      const cpInput = document.getElementById('postal-code') as HTMLInputElement | null;
      const cp = (cpInput?.value || '').trim();

      if (!/^\d{5}$/.test(cp)) {
        estado.textContent = 'Enter your postal code to see the options and their prices.';
        lista.innerHTML = '';
        tarifaPakke = null;
        ultimoCpCotizado = '';
        estadoPakke = 'sin-cp';
        refrescarTrasCotizar();
        return;
      }
      if (cp === ultimoCpCotizado && !forzar) return;

      estado.textContent = 'Looking up carriers…';
      lista.innerHTML = '';
      estadoPakke = 'cargando';
      refrescarTrasCotizar();

      try {
        const res = await fetch('/api/cotizar-envio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigoPostal: cp, items: itemsParaCotizar() }),
        });
        const datos = await res.json();
        const opciones = Array.isArray(datos?.opciones) ? datos.opciones : [];
        ultimoCpCotizado = cp;

        if (opciones.length === 0) {
          estado.textContent = 'No live quote available right now; the standard rate applies.';
          tarifaPakke = null;
          estadoPakke = 'fallback';
          refrescarTrasCotizar();
          return;
        }

        estado.textContent = '';
        lista.innerHTML = opciones
          .map(
            (o: any, i: number) => `
            <label class="flex cursor-pointer items-center justify-between gap-3 rounded-md border border-border bg-background px-3 py-2 text-sm has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary">
              <span class="flex items-center gap-2">
                <input type="radio" name="pakke-service" value="${o.serviceId}" data-total="${o.subtotal}" data-courier="${o.courierName}" ${i === 0 ? 'checked' : ''} />
                <span>
                  <span class="font-medium text-foreground">${o.courierName}</span>
                  <span class="block text-xs text-muted-foreground">${detallePaqueteria(o)}</span>
                </span>
              </span>
              <span class="font-medium text-foreground">${formatPrice(aUSD(Number(o.subtotal), 'MXN'), monedaElegida())}</span>
            </label>`
          )
          .join('');

        const primera = opciones[0];
        tarifaPakke = { serviceId: primera.serviceId, courierName: primera.courierName, total: Number(primera.subtotal) };
        estadoPakke = 'ok';

        lista.querySelectorAll('input[name="pakke-service"]').forEach((r) => {
          r.addEventListener('change', () => {
            const el = r as HTMLInputElement;
            tarifaPakke = {
              serviceId: el.value,
              courierName: el.dataset.courier || '',
              total: Number(el.dataset.total) || 0,
            };
            refrescarTrasCotizar();
          });
        });

        refrescarTrasCotizar();
      } catch {
        estadoPakke = 'fallback';
        estado.textContent = 'No live quote available right now; the standard rate applies.';
        tarifaPakke = null;
        refrescarTrasCotizar();
      }
    }

    function getSelectedDeliveryMethod(): string {
      const selected = document.querySelector('input[name="delivery-method"]:checked') as HTMLInputElement;
      return selected?.value || '';
    }

    function toggleShippingFields(method: string) {
      const section = document.getElementById('shipping-info-section');
      const fields = document.getElementById('shipping-address-fields');
      const addressInputs = fields?.querySelectorAll('input:not([readonly])') as NodeListOf<HTMLInputElement>;
      const isPickup = isPickupMethod(method as DeliveryMethod);

      if (!section) return;

      if (isPickup) {
        section.classList.add('hidden');
        addressInputs?.forEach(input => input.removeAttribute('required'));
      } else {
        section.classList.remove('hidden');
        addressInputs?.forEach(input => input.setAttribute('required', ''));
      }
    }

    function updateDeliveryPrices(subtotal: number) {
      // Recorre la fuente única: si mañana se agrega una opción de entrega,
      // su precio se actualiza aquí sin tocar este código.
      for (const option of DELIVERY_OPTIONS) {
        if (option.cost === 0) continue;
        const el = document.getElementById(`price-${option.value}`);
        if (!el) continue;

        // Con paquetería el precio depende del destino. Mientras no haya tarifa
        // se dice de dónde saldrá, aunque la opción no esté seleccionada: los
        // $350 son solo el respaldo de cuando Pakke no responde, y anunciarlos
        // de entrada promete una tarifa que casi nunca se cobra.
        if (option.value === 'paqueteria' && estadoPakke !== 'ok' && estadoPakke !== 'fallback') {
          el.textContent = estadoPakke === 'cargando' ? 'Calculating…' : 'Calculated from your ZIP';
          el.className = 'ml-4 shrink-0 text-sm font-medium text-muted-foreground';
          continue;
        }

        const cost = option.value === 'paqueteria' && estadoPakke === 'ok' && tarifaPakke
          ? tarifaPakke.total
          : getShippingCost(option.value, subtotal);
        const isFree = cost === 0;
        el.textContent = isFree ? 'Free' : `$${cost.toFixed(2)}`;
        el.className = `ml-4 shrink-0 text-sm font-medium ${isFree ? 'text-green-600' : ''}`;
      }
    }

    // Function to load Stripe Elements directly
    async function loadStripeForm(container: HTMLElement, clientSecret: string, amount: number, currency: string = 'USD') {
      try {
        console.log('📦 Loading Stripe...');
        
        // Check if Stripe is already loaded
        if ((window as any).Stripe) {
          console.log('✅ Stripe already loaded');
          initializeStripe(container, clientSecret, amount, currency);
          return;
        }

        // Verify we have the publishable key
        const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY;
        if (!publishableKey) {
          throw new Error('PUBLIC_STRIPE_PUBLISHABLE_KEY is not configured');
        }
        console.log('🔑 Stripe publishable key found');

        // Load Stripe from CDN
        return new Promise<void>((resolve, reject) => {
          // Check if script already exists
          const existingScript = document.querySelector('script[src="https://js.stripe.com/v3/"]');
          if (existingScript) {
            console.log('✅ Stripe script already exists');
            initializeStripe(container, clientSecret, amount, currency);
            resolve();
            return;
          }

          const stripeScript = document.createElement('script');
          stripeScript.src = 'https://js.stripe.com/v3/';
          stripeScript.onload = () => {
            console.log('✅ Stripe script loaded successfully');
            try {
              initializeStripe(container, clientSecret, amount, currency);
              resolve();
            } catch (error) {
              console.error('❌ Error initializing Stripe after loading:', error);
              reject(error);
            }
          };
          stripeScript.onerror = () => {
            console.error('❌ Error loading Stripe script');
            reject(new Error('Could not load Stripe script'));
          };
          document.head.appendChild(stripeScript);
        });
      } catch (error) {
        console.error('❌ Error loading Stripe:', error);
        const errorMessage = error instanceof Error ? error.message : 'Unknown error';
        container.innerHTML = `
          <div class="p-4 bg-red-50 border border-red-200 rounded-md">
            <p class="text-red-800 font-medium">Error loading Stripe</p>
            <p class="text-red-600 text-sm mt-1">${errorMessage}</p>
            <p class="text-red-600 text-xs mt-2">Please verify that PUBLIC_STRIPE_PUBLISHABLE_KEY is configured correctly.</p>
          </div>
        `;
        throw error;
      }
    }

    // Global variables to store Payment Element instance
    let currentPaymentElement: any = null;
    let currentStripe: any = null;
    let currentElements: any = null;
    let isElementMounted = false;

    // Function to initialize Stripe
    function initializeStripe(container: HTMLElement, clientSecret: string, amount: number, currency: string = 'USD') {
      try {
        console.log('💳 Initializing Stripe Elements...');
        console.log('🔑 Client Secret received:', clientSecret ? 'Yes (hidden for security)' : 'No');
        
        const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY;
        if (!publishableKey) {
          throw new Error('PUBLIC_STRIPE_PUBLISHABLE_KEY is not configured');
        }
        
        if (!clientSecret) {
          throw new Error('Client secret not received from server');
        }

        // Unmount previous Payment Element if exists
        if (currentPaymentElement) {
          try {
            console.log('🗑️ Unmounting previous Payment Element...');
            currentPaymentElement.unmount();
            currentPaymentElement = null;
            isElementMounted = false;
          } catch (unmountError) {
            console.warn('⚠️ Error unmounting previous Payment Element:', unmountError);
          }
        }

        const stripe = (window as any).Stripe(publishableKey);
        
        if (!stripe) {
          throw new Error('Could not initialize Stripe. Verify that the script loaded correctly.');
        }
        
        console.log('✅ Stripe initialized correctly');
        
        const elements = stripe.elements({
          clientSecret: clientSecret,
          appearance: {
            theme: 'stripe',
            variables: {
              colorPrimary: '#3b82f6',
              colorBackground: 'transparent',
              colorText: '#1f2937',
            }
          }
        });

        const paymentElement = elements.create('payment');
        
        // Save global references
        currentStripe = stripe;
        currentElements = elements;
        currentPaymentElement = paymentElement;
        
        // Get cart currency
        const cart = getCartFromStorage();
        const cartCurrency = monedaElegida();
        
        container.innerHTML = `
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-foreground mb-2">
                Payment Method
              </label>
              <div id="payment-element" class="p-4 border border-border rounded-md bg-background">
                <!-- Stripe Elements will load here -->
              </div>
            </div>
            
            <div class="flex items-center justify-between text-sm">
              <span class="text-muted-foreground">Total to pay:</span>
              <span class="font-semibold text-foreground">${formatPrice(amount, cartCurrency)}</span>
            </div>

            <button 
              id="submit-payment" 
              class="w-full bg-primary text-primary-foreground py-2 px-4 rounded-md hover:bg-primary/90 transition-colors disabled:opacity-50"
            >
              Pay ${formatPrice(amount, cartCurrency)}
            </button>

            <div id="payment-message" class="hidden"></div>
          </div>
        `;

        const paymentElementDiv = document.getElementById('payment-element');
        if (!paymentElementDiv) {
          throw new Error('Payment element container not found');
        }

        const submitButton = document.getElementById('submit-payment');
        const messageDiv = document.getElementById('payment-message');

        if (!submitButton) {
          throw new Error('Submit button not found');
        }

        // Get reference to visible button (used in callbacks)
        const submitBtn = submitButton as HTMLButtonElement;

        // Disable button until Payment Element is ready
        submitBtn.disabled = true;
        submitBtn.textContent = 'Loading payment form...';

        console.log('📦 Mounting Payment Element...');
        
        // Reset mount state
        isElementMounted = false;
        
        // Wait for next frame to ensure DOM is ready
        requestAnimationFrame(() => {
          paymentElement.mount(paymentElementDiv);
        });
        
        // Wait for Payment Element to be completely ready
        paymentElement.on('ready', () => {
          console.log('✅ Payment Element ready and mounted');
          isElementMounted = true;
          submitBtn.disabled = false;
          submitBtn.textContent = `Pay ${formatPrice(amount, currency)}`;
        });

        // Handle Payment Element errors
        paymentElement.on('change', (event: any) => {
          if (event.error) {
            console.error('❌ Payment Element error:', event.error);
            if (messageDiv) {
              messageDiv.textContent = event.error.message || 'Error in payment form';
              messageDiv.className = 'text-red-600 text-sm mt-2 p-2 bg-red-50 rounded';
              messageDiv.classList.remove('hidden');
            }
          } else {
            // Clear error message if fixed
            if (messageDiv) {
              messageDiv.classList.add('hidden');
            }
          }
        });

        // Handle Payment Element load error (e.g. 400 from Stripe - domain not registered)
        paymentElement.on('loaderror', (event: any) => {
          console.error('❌ Error loading Payment Element:', event);
          isElementMounted = false;
          if (messageDiv) {
            messageDiv.innerHTML = 'Could not load payment form. If you\'re in production, add your domain in Stripe: <a href="https://dashboard.stripe.com/settings/payment_method_domains" target="_blank" rel="noopener" class="underline">Domain settings</a>.';
            messageDiv.className = 'text-red-600 text-sm mt-2 p-2 bg-red-50 rounded';
            messageDiv.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.textContent = `Retry - Pay ${formatPrice(amount, currency)}`;
        });
        
        // Add listener to button
        submitBtn.addEventListener('click', async () => {
          // Verify element is mounted before confirming
          if (!isElementMounted) {
            console.warn('⚠️ Payment Element not ready yet');
            if (messageDiv) {
              messageDiv.textContent = 'Please wait for the payment form to finish loading';
              messageDiv.className = 'text-yellow-600 text-sm mt-2 p-2 bg-yellow-50 rounded';
              messageDiv.classList.remove('hidden');
            }
            return;
          }

          // Verify that Payment Element is really mounted
          if (!currentPaymentElement || !currentStripe || !currentElements) {
            console.error('❌ Payment Element is not available');
            if (messageDiv) {
              messageDiv.textContent = 'Error: Payment form is not ready. Please reload the page.';
              messageDiv.className = 'text-red-600 text-sm mt-2 p-2 bg-red-50 rounded';
              messageDiv.classList.remove('hidden');
            }
            return;
          }

          console.log('🔄 Processing payment...');
          submitBtn.disabled = true;
          submitBtn.textContent = 'Processing...';
          
          // Clear previous messages
          if (messageDiv) {
            messageDiv.classList.add('hidden');
          }
          
          try {
            const { error } = await currentStripe.confirmPayment({
              elements: currentElements,
              confirmParams: {
                return_url: `${window.location.origin}/en/purchase-success`,
              },
            });

            if (error) {
              console.error('❌ Payment error:', error);
              if (messageDiv) {
                messageDiv.textContent = error.message || 'An unexpected error occurred.';
                messageDiv.className = 'text-red-600 text-sm mt-2 p-2 bg-red-50 rounded';
                messageDiv.classList.remove('hidden');
              }
              submitBtn.disabled = false;
              submitBtn.textContent = `Pay ${formatPrice(amount, currency)}`;
            } else {
              console.log('✅ Payment processed successfully');
              if (messageDiv) {
                messageDiv.textContent = 'Payment successful! Redirecting...';
                messageDiv.className = 'text-green-600 text-sm mt-2 p-2 bg-green-50 rounded';
                messageDiv.classList.remove('hidden');
              }
            }
          } catch (error) {
            console.error('❌ Error processing payment:', error);
            if (messageDiv) {
              messageDiv.textContent = error instanceof Error ? error.message : 'Error processing payment';
              messageDiv.className = 'text-red-600 text-sm mt-2 p-2 bg-red-50 rounded';
              messageDiv.classList.remove('hidden');
            }
            submitBtn.disabled = false;
            submitBtn.textContent = `Pay ${formatPrice(amount, currency)}`;
          }
        });

        console.log('✅ Stripe Elements fully initialized');

      } catch (error) {
        console.error('❌ Error initializing Stripe:', error);
        const errorMessage = error instanceof Error ? error.message : 'Unknown error';
        container.innerHTML = `
          <div class="p-4 bg-red-50 border border-red-200 rounded-md">
            <p class="text-red-800 font-medium">Error initializing Stripe</p>
            <p class="text-red-600 text-sm mt-1">${errorMessage}</p>
            <p class="text-red-600 text-xs mt-2">Please check the browser console (F12) for more details.</p>
          </div>
        `;
        throw error;
      }
    }

    // Discount state
    let appliedDiscount: {
      code: string;
      discountCodeId: number;
      amount: number;
    } | null = null;

    // Function to render order summary
    function renderOrderSummary() {
      console.log('🔍 Starting renderOrderSummary...');
      const cart = getCartFromStorage();
      console.log('🛒 Cart obtained:', cart);

      // If cart is empty, redirect to cart page
      if (cart.items.length === 0) {
        console.log('🛒 Empty cart, redirecting...');
        window.location.href = '/en/cart';
        return null;
      }

      const orderItemsList = document.getElementById('order-items-list');
      const orderSummary = document.getElementById('order-summary');
      console.log('🎯 Elements found:', { orderItemsList, orderSummary });

      if (!orderItemsList || !orderSummary) {
        console.log('❌ DOM elements not found');
        return cart;
      }

      // El resumen va en la moneda elegida, que es en la que se cobra
      const cartCurrency = monedaElegida();

      // Render items
      orderItemsList.innerHTML = cart.items.map(item => `
        <li class="flex px-4 py-6 sm:px-6">
          <div class="shrink-0">
            ${item.image_url ?
              `<img src="${item.image_url}" alt="${item.name}" class="w-20 rounded-md" />` :
              `<div class="w-20 h-20 bg-muted rounded-md flex items-center justify-center">
                <span class="text-muted-foreground text-xs">No image</span>
              </div>`
            }
          </div>
          <div class="ml-6 flex flex-1 flex-col">
            <div class="flex">
              <div class="min-w-0 flex-1">
                <h4 class="text-sm">
                  <span class="font-medium text-foreground">${item.name}</span>
                </h4>
                ${item.color ? `<p class="mt-1 text-sm text-muted-foreground">Color: ${item.color}</p>` : ''}
                ${item.size ? `<p class="mt-1 text-sm text-muted-foreground">Model: ${item.size}</p>` : ''}
                ${item.bind_code ? `<p class="mt-1 text-sm text-muted-foreground">Code: ${item.bind_code}</p>` : ''}
                ${item.efficiency ? `<p class="mt-1 text-sm text-muted-foreground">Efficiency: ${item.efficiency}</p>` : ''}
                ${item.category ? `<p class="mt-1 text-sm text-muted-foreground">Category: ${item.category}</p>` : ''}
              </div>
            </div>
            <div class="flex flex-1 items-end justify-between pt-2">
              ${item.quantity > 1
                ? `<p class="mt-1 text-sm text-muted-foreground">${formatPrice(aUSD(item.price, item.currency), cartCurrency)} <span class="text-xs">each</span></p>
                   <p class="text-sm font-semibold text-foreground">Total: ${formatPrice(aUSD(item.price, item.currency) * item.quantity, cartCurrency)}</p>`
                : `<p class="mt-1 text-sm font-medium text-foreground">${formatPrice(aUSD(item.price, item.currency), cartCurrency)}</p>`}
              <div class="ml-4">
                <span class="text-sm text-muted-foreground">Quantity: ${item.quantity}</span>
              </div>
            </div>
          </div>
        </li>
      `).join('');

      // Calculate totals
      const subtotal = cart.items.reduce(
        (suma: number, item: any) => suma + aUSD(item.price, item.currency) * item.quantity,
        0
      );
      // The discount comes from the server IN PESOS (codes are defined in MXN).
      // It was converted "from cart.currency", i.e. not at all on the English
      // site, so $500 MXN were subtracted as if they were $500 USD.
      const discountAmount = aCentavos(aUSD(appliedDiscount?.amount || 0, 'MXN'));
      const subtotalAfterDiscount = Math.max(0, aCentavos(subtotal - discountAmount));
      const deliveryMethod = getSelectedDeliveryMethod();
      // getShippingCost devuelve pesos (tarifas reales): se convierte a USD
      const subtotalMXN = monedaElegida() === 'MXN'
        ? subtotalAfterDiscount
        : subtotalAfterDiscount * tasaCambio;
      const shipping = deliveryMethod
        ? aUSD(costoEnvio(deliveryMethod, subtotalMXN), 'MXN')
        : 0;
      // VAT also applies to shipping (same rule as the server).
      // Rounded to cents like the server, so the lines add up to the total.
      const tax = aCentavos((subtotalAfterDiscount + aCentavos(shipping)) * 0.16);
      const total = aCentavos(subtotalAfterDiscount + aCentavos(shipping) + tax);

      updateDeliveryPrices(subtotalAfterDiscount);

      const deliveryLabel = deliveryMethod ? (getDeliveryLabel(deliveryMethod as DeliveryMethod, 'en') || 'Shipping') : 'Select delivery method';

      // Render summary
      let summaryHTML = `
        <div class="flex items-center justify-between">
          <dt class="text-sm text-muted-foreground">Subtotal</dt>
          <dd class="text-sm font-medium text-foreground">${formatPrice(subtotal, cartCurrency)}</dd>
        </div>
      `;

      if (appliedDiscount) {
        summaryHTML += `
          <div class="flex items-center justify-between">
            <dt class="text-sm text-green-600">Discount (${appliedDiscount.code})</dt>
            <dd class="text-sm font-medium text-green-600">-${formatPrice(discountAmount, cartCurrency)}</dd>
          </div>
        `;
      }

      summaryHTML += `
        <div class="flex items-center justify-between">
          <dt class="text-sm text-muted-foreground">${deliveryLabel}</dt>
          <dd class="text-sm font-medium ${envioPorCalcular(deliveryMethod) ? 'text-muted-foreground' : (shipping === 0 && deliveryMethod ? 'text-green-600' : 'text-foreground')}">${envioPorCalcular(deliveryMethod) ? (estadoPakke === 'cargando' ? 'Calculating…' : 'Calculated from your ZIP') : (shipping === 0 && deliveryMethod ? 'Free' : formatPrice(shipping, cartCurrency))}</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-sm text-muted-foreground">Tax (VAT 16%)</dt>
          <dd class="text-sm font-medium text-foreground">${formatPrice(tax, cartCurrency)}</dd>
        </div>
        <div class="flex items-center justify-between border-t border-border pt-6">
          <dt class="text-base font-medium text-foreground">Total</dt>
          <dd class="text-base font-medium text-foreground">${formatPrice(total, cartCurrency)}</dd>
        </div>
        <p class="text-xs text-muted-foreground">${cartCurrency === 'USD' ? 'Your card will be charged in US dollars (USD).' : 'Your card will be charged in Mexican pesos (MXN).'}</p>
      `;

      orderSummary.innerHTML = summaryHTML;

      console.log('✅ Order summary rendered correctly');
      return cart;
    }

    // Function to apply discount code
    async function applyDiscountCode() {
      const input = document.getElementById('discount-code') as HTMLInputElement;
      const button = document.getElementById('apply-discount') as HTMLButtonElement;
      const messageDiv = document.getElementById('discount-message');

      if (!input || !button || !messageDiv) return;

      const code = input.value.trim().toUpperCase();
      if (!code) {
        messageDiv.textContent = 'Please enter a code';
        messageDiv.className = 'mt-2 text-sm text-red-600';
        messageDiv.classList.remove('hidden');
        return;
      }

      button.disabled = true;
      button.textContent = 'Applying...';

      try {
        const cart = getCartFromStorage();
        const response = await fetch('/api/validate-discount-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code: code,
            // In pesos: the code's minimum purchase is in MXN and cart.total adds
            // each line in the currency it was added with.
            subtotal: aCentavos(cart.items.reduce(
              (suma: number, item: any) => suma + aMXN(Number(item.price) || 0, item.currency) * (item.quantity || 1), 0)),
            cartItems: cart.items, // Send cart items to validate allowed products
          }),
        });

        const data = await response.json();

        if (data.success) {
          appliedDiscount = {
            code: code,
            discountCodeId: data.discountCode.id,
            amount: data.discountAmount,
          };
          messageDiv.textContent = `✓ ${data.message} - Savings: ${formatPrice(aCentavos(aUSD(data.discountAmount, 'MXN')), monedaElegida())}`;
          messageDiv.className = 'mt-2 text-sm text-green-600';
          messageDiv.classList.remove('hidden');
          input.disabled = true;
          button.textContent = 'Applied';
          renderOrderSummary();
        } else {
          messageDiv.textContent = data.message;
          messageDiv.className = 'mt-2 text-sm text-red-600';
          messageDiv.classList.remove('hidden');
          button.disabled = false;
          button.textContent = 'Apply';
        }
      } catch (error) {
        console.error('Error applying discount code:', error);
        messageDiv.textContent = 'Error applying discount code';
        messageDiv.className = 'mt-2 text-sm text-red-600';
        messageDiv.classList.remove('hidden');
        button.disabled = false;
        button.textContent = 'Apply';
      }
    }

    // With ClientRouter this module evaluates once per session and
    // DOMContentLoaded does not fire again on navigation: arriving via
    // "Checkout" left the page uninitialized. Re-init on every DOMContentLoaded
    // with a guard to avoid duplicate listeners.
    async function initCheckout() {
      const deliveryOptions = document.getElementById('delivery-options');
      if (!deliveryOptions || deliveryOptions.hasAttribute('data-checkout-init')) return;
      deliveryOptions.setAttribute('data-checkout-init', 'true');
      refrescarBotonConfirmar = updateConfirmButton;
      initInvoiceToggle();
      // Antes de pintar importes: el resumen va en MXN y hay que convertir
      await cargarTasaCambio();
      console.log('🚀 initCheckout started');

      // First render order summary
      console.log('📦 Rendering order summary...');
      const cart = renderOrderSummary();
      console.log('📦 Cart after rendering:', cart);
      
      if (!cart) {
        console.log('❌ No cart, returning');
        return;
      }

      const paymentFormContainer = document.getElementById('stripe-payment-form');
      const confirmBtn = document.getElementById('confirm-info-btn') as HTMLButtonElement;
      const confirmBtnWrapper = document.getElementById('confirm-button-wrapper');
      const confirmedSummary = document.getElementById('confirmed-info-summary');
      const confirmedDetails = document.getElementById('confirmed-details');
      const editInfoBtn = document.getElementById('edit-info-btn');
      const confirmValidationMsg = document.getElementById('confirm-validation-msg');
      const paymentSection = document.getElementById('payment-section');
      
      if (!paymentFormContainer || !confirmBtn) {
        console.log('❌ Checkout elements not found');
        return;
      }

      // Confirmation state
      let isInfoConfirmed = false;
      let isLoadingPaymentForm = false;

      // Add discount code button listener
      const applyDiscountButton = document.getElementById('apply-discount');
      if (applyDiscountButton) {
        applyDiscountButton.addEventListener('click', applyDiscountCode);
      }

      // Also allow Enter key on discount input
      const discountInput = document.getElementById('discount-code');
      if (discountInput) {
        discountInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            applyDiscountCode();
          }
        });
      }

      // Function to update confirm button state
      function updateConfirmButton() {
        if (isInfoConfirmed) return;
        
        const deliveryMethod = getSelectedDeliveryMethod();
        const isPickup = isPickupMethod(deliveryMethod as DeliveryMethod);
        
        if (!deliveryMethod) {
          confirmBtn.disabled = true;
          confirmBtn.textContent = 'Select a delivery method to continue';
          return;
        }

        if (isPickup) {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Confirm and continue to payment';
        } else {
          const address = (document.getElementById('address') as HTMLInputElement)?.value?.trim();
          const city = (document.getElementById('city') as HTMLInputElement)?.value?.trim();
          const state = (document.getElementById('state') as HTMLInputElement)?.value?.trim();
          const postalCode = (document.getElementById('postal-code') as HTMLInputElement)?.value?.trim();

          // With carrier shipping we cannot continue until there is a rate:
          // the summary does not include shipping yet, so the charge would be
          // higher than the total the buyer is looking at.
          if (envioPorCalcular(deliveryMethod)) {
            confirmBtn.disabled = true;
            confirmBtn.textContent = estadoPakke === 'cargando'
              ? 'Calculating shipping…'
              : 'Enter your postal code to calculate shipping';
            return;
          }

          if (address && city && state && postalCode) {
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Confirm information and continue to payment';
          } else {
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Complete shipping address to continue';
          }
        }
      }

      // Function to reset confirmation state
      function resetConfirmation() {
        if (!isInfoConfirmed) return;
        
        isInfoConfirmed = false;
        isLoadingPaymentForm = false;
        
        if (confirmBtnWrapper) confirmBtnWrapper.classList.remove('hidden');
        if (confirmedSummary) confirmedSummary.classList.add('hidden');
        
        paymentFormContainer.innerHTML = `
          <div id="payment-locked" class="p-6 bg-muted/30 border border-dashed border-border rounded-lg text-center">
            <svg class="w-10 h-10 text-muted-foreground/50 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <p class="text-sm text-muted-foreground">Please confirm your shipping information first to continue with payment.</p>
          </div>
        `;
        
        if (currentPaymentElement) {
          try {
            currentPaymentElement.unmount();
            currentPaymentElement = null;
            isElementMounted = false;
          } catch (e) {
            console.warn('⚠️ Error unmounting Payment Element:', e);
          }
        }
        
        updateConfirmButton();
        console.log('🔄 Confirmation reset');
      }

      // Function to confirm information
      async function confirmInfo() {
        const deliveryMethod = getSelectedDeliveryMethod();
        const isPickup = isPickupMethod(deliveryMethod as DeliveryMethod);
        const email = (document.getElementById('email-address') as HTMLInputElement)?.value;
        const firstName = (document.getElementById('first-name') as HTMLInputElement)?.value;
        const lastName = (document.getElementById('last-name') as HTMLInputElement)?.value;
        
        if (!deliveryMethod) {
          if (confirmValidationMsg) {
            confirmValidationMsg.textContent = 'Please select a delivery method.';
            confirmValidationMsg.classList.remove('hidden');
          }
          return;
        }

        if (!isPickup) {
          const address = (document.getElementById('address') as HTMLInputElement)?.value?.trim();
          const city = (document.getElementById('city') as HTMLInputElement)?.value?.trim();
          const state = (document.getElementById('state') as HTMLInputElement)?.value?.trim();
          const postalCode = (document.getElementById('postal-code') as HTMLInputElement)?.value?.trim();
          
          const missingFields: string[] = [];
          if (!address) missingFields.push('Address');
          if (!city) missingFields.push('City');
          if (!state) missingFields.push('State');
          if (!postalCode) missingFields.push('Postal code');
          
          if (missingFields.length > 0) {
            if (confirmValidationMsg) {
              confirmValidationMsg.textContent = `Please complete: ${missingFields.join(', ')}`;
              confirmValidationMsg.classList.remove('hidden');
            }
            return;
          }
        }

        if (confirmValidationMsg) confirmValidationMsg.classList.add('hidden');

        isInfoConfirmed = true;
        
        // Icon per method; the name comes from the single source.
        const deliveryIcons: Record<string, string> = {
          'pickup-gdl': '📍', 'pickup-cdmx': '📍',
          'metro-gdl': '🚚', 'metro-cdmx': '🚚',
          'paqueteria': '📦',
        };
        
        let summaryHTML = `<p><strong>Delivery:</strong> ${deliveryIcons[deliveryMethod] || ''} ${getDeliveryLabel(deliveryMethod as DeliveryMethod, 'en') || deliveryMethod}</p>`;
        
        if (!isPickup) {
          const address = (document.getElementById('address') as HTMLInputElement)?.value;
          const city = (document.getElementById('city') as HTMLInputElement)?.value;
          const state = (document.getElementById('state') as HTMLInputElement)?.value;
          const postalCode = (document.getElementById('postal-code') as HTMLInputElement)?.value;
          summaryHTML += `<p><strong>Address:</strong> ${address}, ${city}, ${state}, ZIP ${postalCode}</p>`;
        }
        
        summaryHTML += `<p><strong>Contact:</strong> ${firstName} ${lastName} (${email})</p>`;
        
        if (confirmedDetails) confirmedDetails.innerHTML = summaryHTML;
        
        if (confirmBtnWrapper) confirmBtnWrapper.classList.add('hidden');
        if (confirmedSummary) confirmedSummary.classList.remove('hidden');

        if (paymentSection) {
          paymentSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        await loadPaymentForm();
      }

      // Function to load payment form
      const loadPaymentForm = async () => {
        if (isLoadingPaymentForm) return;
        
        try {
          const email = (document.getElementById('email-address') as HTMLInputElement)?.value;
          const firstName = (document.getElementById('first-name') as HTMLInputElement)?.value;
          const lastName = (document.getElementById('last-name') as HTMLInputElement)?.value;
          const address = (document.getElementById('address') as HTMLInputElement)?.value;
          const city = (document.getElementById('city') as HTMLInputElement)?.value;
          const state = (document.getElementById('state') as HTMLInputElement)?.value;
          const postalCode = (document.getElementById('postal-code') as HTMLInputElement)?.value;
          const country = (document.getElementById('country') as HTMLInputElement)?.value;
          const phone = (document.getElementById('phone') as HTMLInputElement)?.value?.trim();
          const deliveryMethod = getSelectedDeliveryMethod();

          isLoadingPaymentForm = true;

          paymentFormContainer.innerHTML = '<div class="flex items-center justify-center p-8"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div><p class="ml-3 text-sm text-muted-foreground">Preparing payment form...</p></div>';

          const checkoutData = {
            email,
            firstName,
            lastName,
            address,
            city,
            state,
            postalCode,
            country,
            phone,
          };

          console.log('💳 Creating Payment Intent with Stripe...');

          const cart = getCartFromStorage();
          
          if (cart.items.length === 0) {
            isLoadingPaymentForm = false;
            paymentFormContainer.innerHTML = '<p class="text-red-600">Your cart is empty. Please add products before continuing.</p>';
            return;
          }

          const cartCurrency = 'MXN';
          const subtotal = cart.items.reduce(
            (suma: number, item: any) => suma + aUSD(item.price, item.currency) * item.quantity,
            0
          );
          // The discount comes from the server IN PESOS (codes are defined in MXN).
          // It was converted "from cart.currency", i.e. not at all on the English
          // site, so $500 MXN were subtracted as if they were $500 USD.
          const discountAmount = aCentavos(aUSD(appliedDiscount?.amount || 0, 'MXN'));
          const subtotalAfterDiscount = Math.max(0, aCentavos(subtotal - discountAmount));
          const shipping = aUSD(
            costoEnvio(
              deliveryMethod,
              monedaElegida() === 'MXN' ? subtotalAfterDiscount : subtotalAfterDiscount * tasaCambio
            ),
            'MXN'
          );
          // Rounded to cents like the server, so the lines add up to the total.
          const tax = aCentavos((subtotalAfterDiscount + aCentavos(shipping)) * 0.16);
          const total = aCentavos(subtotalAfterDiscount + aCentavos(shipping) + tax);

          const minAmount = cartCurrency === 'USD' ? 0.50 : 10.00;
          if (total < minAmount) {
            isLoadingPaymentForm = false;
            paymentFormContainer.innerHTML = `
              <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-md">
                <p class="text-yellow-800 font-medium">Minimum amount required</p>
                <p class="text-yellow-700 text-sm mt-1">
                  The minimum purchase amount is ${formatPrice(minAmount, cartCurrency)}. 
                  Your current total is ${formatPrice(total, cartCurrency)}.
                </p>
                <p class="text-yellow-600 text-xs mt-2">
                  Please add more products to your cart to continue with the purchase.
                </p>
              </div>
            `;
            return;
          }

          const response = await fetch('/api/create-payment-intent', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              ...checkoutData,
              currency: monedaElegida(),
              billing: getBillingData(),
              items: cart.items,
              shippingMethod: deliveryMethod,
              // Cuál paquetería eligió: el servidor recotiza y cobra esa misma.
              shippingServiceId: tarifaPakke?.serviceId || null,
              discountCode: appliedDiscount ? {
                code: appliedDiscount.code,
                discountCodeId: appliedDiscount.discountCodeId,
                amount: appliedDiscount.amount
              } : undefined
            }),
          });

          if (!response.ok) {
            const errorData = await response.json();
            console.error('❌ Server error:', errorData);
            // The server sends the concrete cause in `details` (which product and
            // how many units are left); without it users only saw "Stock insuficiente".
            const detail = Array.isArray(errorData.details) ? errorData.details.join(' ') : '';
            const base = errorData.error || 'Error creating payment';
            throw new Error(detail ? `${base}. ${detail}` : base);
          }

          const paymentData = await response.json();
          console.log('✅ Payment Intent created:', {
            paymentIntentId: paymentData.payment_intent_id,
            orderTotal: paymentData.order_total,
            hasClientSecret: !!paymentData.client_secret
          });

          if (!paymentData.client_secret) {
            throw new Error('Client secret not received from server');
          }

          await loadStripeForm(paymentFormContainer, paymentData.client_secret, paymentData.order_total, paymentData.currency || monedaElegida());
        } catch (error) {
          console.error('❌ Complete error:', error);
          isLoadingPaymentForm = false;
          const errorMessage = error instanceof Error ? error.message : 'Unknown error';
          paymentFormContainer.innerHTML = `
            <div class="p-4 bg-red-50 border border-red-200 rounded-md">
              <p class="text-red-800 font-medium">Error initializing payment</p>
              <p class="text-red-600 text-sm mt-1">${errorMessage}</p>
              <p class="text-red-600 text-xs mt-2">If the problem persists, contact us and we will help you complete your order.</p>
            </div>
          `;
        } finally {
          isLoadingPaymentForm = false;
        }
      };

      // Confirm button listener
      confirmBtn.addEventListener('click', confirmInfo);

      // Edit button listener
      if (editInfoBtn) {
        editInfoBtn.addEventListener('click', () => {
          resetConfirmation();
        });
      }

      // Address field listeners (update button state)
      const addressFields = ['address', 'city', 'state', 'postal-code'];
      addressFields.forEach(fieldId => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('input', updateConfirmButton);
          field.addEventListener('change', updateConfirmButton);
        }
      });

      // Delivery method radio button listeners
      // Al escribir el código postal se piden las tarifas reales. Se espera a
      // que deje de teclear para no lanzar una petición por cada dígito.
      const cpInput = document.getElementById('postal-code');
      if (cpInput) {
        let cpTimer: any = null;
        cpInput.addEventListener('input', () => {
          clearTimeout(cpTimer);
          cpTimer = setTimeout(() => cotizarPaqueteria(), 600);
        });
      }

      const deliveryRadios = document.querySelectorAll('input[name="delivery-method"]');
      deliveryRadios.forEach(radio => {
        radio.addEventListener('change', () => {
          const method = (radio as HTMLInputElement).value;
          toggleShippingFields(method);
          if (method !== 'paqueteria') {
            tarifaPakke = null;
            estadoPakke = 'sin-cp';
            // También se olvida el último CP cotizado: si no, al volver a
            // elegir paquetería la cotización se saltaba por "ya es el mismo
            // CP" y el envío se quedaba en cero.
            ultimoCpCotizado = '';
          }
          cotizarPaqueteria();
          renderOrderSummary();
          
          if (isInfoConfirmed) {
            resetConfirmation();
          } else {
            updateConfirmButton();
          }

          // Take the user to the next step: the rest of the form sits below the
          // fold and it wasn't obvious that shipping, billing and payment were
          // still pending after choosing a delivery method.
          const isPickup = isPickupMethod(method as DeliveryMethod);
          const siguiente = isPickup
            ? document.getElementById('billing-section') || document.getElementById('confirm-section')
            : document.getElementById('shipping-info-section');
          siguiente?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      console.log('✅ Checkout initialized with step-by-step flow');
    }

    initCheckout();
    document.addEventListener('astro:page-load', initCheckout);
  </script>
</WebsiteLayout>
