---
import WebsiteLayout from "@/layouts/websiteLayout.astro";
import { ZONA_HORARIA } from "@/lib/timezone";
import CustomModal from "@/components/shared/CustomModal.astro";
import { getAuthenticatedUser } from "@/lib/auth-utils";
import { getOrderDiscountAmount, getUserOrderWithItems } from "@/lib/database";

// Verify authentication
const user = getAuthenticatedUser(Astro.cookies);
if (!user) {
  return Astro.redirect('/en/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

// Get order ID from URL
const { id } = Astro.params;
const orderId = parseInt(id as string);

if (!orderId || isNaN(orderId)) {
  return Astro.redirect('/en/orders');
}

// Get order with items
const orderWithItems = await getUserOrderWithItems(user.id, orderId);

if (!orderWithItems) {
  return Astro.redirect('/en/orders');
}

const { items, ...order } = orderWithItems;

// Utility functions
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: ZONA_HORARIA,
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  }).format(new Date(date));
};

// Los pedidos pueden estar en pesos o en dólares: se formatea con la moneda
// de cada uno y se muestra el código.
const formatCurrency = (amount: number, currency: string = 'MXN') => {
  const moneda = currency === 'USD' ? 'USD' : 'MXN';
  return new Intl.NumberFormat(moneda === 'USD' ? 'en-US' : 'es-MX', {
    style: 'currency',
    currency: moneda,
  }).format(amount) + ` ${moneda}`;
};

const getStatusColor = (status: string) => {
  switch (status) {
    case 'pending':
      return 'bg-yellow-100 text-yellow-800';
    case 'processing':
      return 'bg-blue-100 text-blue-800';
    case 'shipped':
      return 'bg-purple-100 text-purple-800';
    case 'delivered':
      return 'bg-green-100 text-green-800';
    case 'cancelled':
      return 'bg-red-100 text-red-800';
    default:
      return 'bg-gray-100 text-gray-800';
  }
};

const esRecoger = order.delivery_method ? isPickupMethod(order.delivery_method as DeliveryMethod) : false;

const getStatusText = (status: string) => {
  switch (status) {
    case 'pending':
      return 'Pending';
    case 'processing':
      return 'Processing';
    case 'shipped':
      // A pickup order is not "shipped": it is ready at the branch.
      return esRecoger ? 'Ready for pickup' : 'Shipped';
    case 'delivered':
      return 'Delivered';
    case 'cancelled':
      return 'Cancelled';
    default:
      return status;
  }
};

// Desglose del pedido.
//
// Antes se reconstruía aquí: el subtotal salía de los renglones, el envío
// estaba FIJO en cero y el IVA se calculaba solo sobre el subtotal. El total
// mostrado, en cambio, era el realmente cobrado, así que la suma no cuadraba.
//
// Ahora se usa el desglose que guardó el checkout. Los pedidos anteriores a
// esas columnas no lo tienen, y en ese caso se muestra solo el total en vez de
// inventar renglones que no suman.
// Desglose: el guardado en la orden o, en pedidos anteriores a esas columnas,
// el reconstruido desde el total (misma regla con la que se cobró). Ver
// lib/order-breakdown.ts.
const desglose = desgloseDeOrden({
  subtotalRenglones: items.reduce((suma, item) => suma + Number(item.price) * item.quantity, 0),
  total: order.total_amount,
  guardado: {
    subtotal: order.subtotal_amount,
    discount: order.discount_amount,
    shipping: order.shipping_amount,
    tax: order.tax_amount,
  },
  descuentoRegistrado: await getOrderDiscountAmount(order.id),
});
const subtotal = desglose?.subtotal ?? null;
const discount = desglose?.discount ?? null;
const shipping = desglose?.shipping ?? null;
const tax = desglose?.tax ?? null;
const hayDesglose = desglose !== null;
// Si ni así cierran los números, se nombra la diferencia sin inventarla.
const diferencia = Number(order.total_amount) - items.reduce((suma, item) => suma + Number(item.price) * item.quantity, 0);
import { desgloseDeOrden } from '@/lib/order-breakdown';
import { isPickupMethod, type DeliveryMethod } from '@/lib/delivery-options';
---

<WebsiteLayout title={`Order #${order.order_number}`}>
  <!-- pt-12: el navbar es absolute y mide 104px, y <main> solo aporta 64px.
       Sin esto el breadcrumb quedaba 40px por debajo de la barra y no se leía. -->
  <div class="min-h-screen bg-background pt-12">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <li>
            <a href="/en" class="hover:text-foreground transition-colors">Home</a>
          </li>
          <li>
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </li>
          <li>
            <a href="/en/orders" class="hover:text-foreground transition-colors">My Orders</a>
          </li>
          <li>
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
          </li>
          <li class="text-foreground font-medium">Order #{order.order_number}</li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="mb-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold text-foreground">
              Order #{order.order_number}
            </h1>
            <p class="mt-2 text-muted-foreground">
              Placed on {formatDate(order.created_at)}
            </p>
          </div>
          <span class={`inline-flex items-center rounded-full px-4 py-2 text-sm font-medium ${getStatusColor(order.status)}`}>
            {getStatusText(order.status)}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main content -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Order items -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-6">
              Ordered Products
            </h2>
            <div class="space-y-6">
              {items.map((item) => (
                <div class="flex items-center gap-4 p-4 rounded-lg bg-muted/30">
                  <div class="flex-shrink-0">
                    {item.image_url ? (
                      <img
                        src={item.image_url}
                        alt={item.product_name}
                        class="w-16 h-16 object-cover rounded-md"
                      />
                    ) : (
                      <div class="w-16 h-16 bg-muted rounded-md flex items-center justify-center">
                        <svg
                          class="w-8 h-8 text-muted-foreground"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                          ></path>
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex-grow">
                    <h3 class="font-medium text-foreground">
                      {item.product_name}
                    </h3>
                    {item.size && (
                      <p class="text-xs text-muted-foreground">Model: {item.size}</p>
                    )}
                    {item.bind_code && (
                      <p class="text-xs text-muted-foreground">Code: {item.bind_code}</p>
                    )}
                    <p class="text-sm text-muted-foreground">
                      Quantity: {item.quantity}
                    </p>
                  </div>
                  {/* Precio por pieza y total del renglón a la misma altura, cada
                      uno con su etiqueta debajo, y sin partir el importe en dos
                      líneas. */}
                  {item.quantity > 1 && (
                    <div class="text-right shrink-0">
                      <p class="font-medium text-foreground whitespace-nowrap">
                        {formatCurrency(item.price, order.currency)}
                      </p>
                      <p class="text-xs text-muted-foreground">each</p>
                    </div>
                  )}
                  <div class="text-right shrink-0">
                    <p class="font-semibold text-foreground whitespace-nowrap">
                      {formatCurrency(item.price * item.quantity, order.currency)}
                    </p>
                    {item.quantity > 1 && <p class="text-xs text-muted-foreground">Total</p>}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Order information -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-6">
              Order Information
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h3 class="text-sm font-medium text-foreground mb-3">
                  Customer Data
                </h3>
                <div class="space-y-2 text-sm">
                  <div>
                    <span class="text-muted-foreground">Name:</span>
                    <span class="ml-2 text-foreground">{order.customer_name}</span>
                  </div>
                  <div>
                    <span class="text-muted-foreground">Email:</span>
                    <span class="ml-2 text-foreground">{order.customer_email}</span>
                  </div>
                  {order.customer_phone && (
                    <div>
                      <span class="text-muted-foreground">Phone:</span>
                      <span class="ml-2 text-foreground">{order.customer_phone}</span>
                    </div>
                  )}
                </div>
              </div>

              {order.shipping_address && (
                <div>
                  <h3 class="text-sm font-medium text-foreground mb-3">
                    Shipping Address
                  </h3>
                  <p class="text-sm text-foreground whitespace-pre-line">
                    {order.shipping_address}
                  </p>
                </div>
              )}
            </div>
          </div>

          <!-- Order status -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-6">
              Order Status
            </h2>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class={`w-3 h-3 rounded-full ${order.status !== 'cancelled' ? 'bg-green-500' : 'bg-gray-300'}`}></div>
                <div>
                  <p class="font-medium text-foreground">Order Confirmed</p>
                  <p class="text-sm text-muted-foreground">
                    {formatDate(order.created_at)}
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class={`w-3 h-3 rounded-full ${['processing', 'shipped', 'delivered'].includes(order.status) ? 'bg-green-500' : 'bg-gray-300'}`}></div>
                <div>
                  <p class="font-medium text-foreground">In Process</p>
                  {order.status === 'processing' && (
                    <p class="text-sm text-muted-foreground">Your order is being prepared</p>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class={`w-3 h-3 rounded-full ${['shipped', 'delivered'].includes(order.status) ? 'bg-green-500' : 'bg-gray-300'}`}></div>
                <div>
                  <p class="font-medium text-foreground">{esRecoger ? 'Ready for pickup' : 'Shipped'}</p>
                  {order.status === 'shipped' && (
                    <p class="text-sm text-muted-foreground">{esRecoger ? 'You can now pick up your order at the branch' : 'Your order is on its way'}</p>
                  )}
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class={`w-3 h-3 rounded-full ${order.status === 'delivered' ? 'bg-green-500' : 'bg-gray-300'}`}></div>
                <div>
                  <p class="font-medium text-foreground">Delivered</p>
                  {order.status === 'delivered' && (
                    <p class="text-sm text-muted-foreground">Order delivered successfully</p>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Order summary -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-6">
              Order Summary
            </h2>
            <div class="space-y-3">
              {hayDesglose ? (
                <>
                  <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Subtotal:</span>
                    <span class="text-foreground">{formatCurrency(subtotal as number, order.currency)}</span>
                  </div>
                  {discount !== null && discount > 0 && (
                    <div class="flex justify-between text-sm">
                      <span class="text-muted-foreground">Discount:</span>
                      <span class="text-green-600">-{formatCurrency(discount, order.currency)}</span>
                    </div>
                  )}
                  <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Shipping:</span>
                    <span class="text-foreground">{!shipping ? 'Free' : formatCurrency(shipping, order.currency)}</span>
                  </div>
                  <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Tax (VAT 16%):</span>
                    <span class="text-foreground">{formatCurrency(tax ?? 0, order.currency)}</span>
                  </div>
                </>
              ) : (
                diferencia > 0.5 && (
                  <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Shipping &amp; taxes:</span>
                    <span class="text-foreground">{formatCurrency(diferencia, order.currency)}</span>
                  </div>
                )
              )}
              <div class="border-t border-border pt-3">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-semibold text-foreground">Total:</span>
                  <span class="font-bold text-base text-foreground whitespace-nowrap">
                    {formatCurrency(order.total_amount, order.currency)}
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-4">
              Actions
            </h2>
            <div class="space-y-3">
              <a
                href="/en/orders"
                class="block w-full text-center rounded-md bg-secondary px-4 py-2 text-sm font-semibold text-secondary-foreground hover:bg-secondary/90 transition-colors"
              >
                View All Orders
              </a>
              <a
                href="/en/products"
                class="block w-full text-center rounded-md bg-secondary px-4 py-2 text-sm font-semibold text-secondary-foreground hover:bg-secondary/90 transition-colors"
              >
                Continue Shopping
              </a>
            </div>
          </div>

          <!-- Help -->
          <div class="bg-card rounded-lg border border-border p-8">
            <h2 class="text-lg font-semibold text-foreground mb-4">
              Need Help?
            </h2>
            <div class="space-y-3 text-sm">
              <p class="text-muted-foreground">
                If you have questions about your order, feel free to contact us.
              </p>
              <a
                href="/en/contact"
                class="inline-flex items-center text-primary hover:text-foreground font-medium"
              >
                Contact Support →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom confirmation modal -->
  <CustomModal id="confirm-dialog" />
</WebsiteLayout>

<script>
  // Function to cancel order
</script>
