---
import ProductDetail from "@/components/shared/ProductDetail.astro";
import { getProductByUuid } from "@/lib/product-service";

// Get product UUID from URL
const { id: uuid } = Astro.params;

// Verify UUID is valid
if (!uuid || typeof uuid !== 'string') {
  return Astro.redirect('/en/products');
}

// Get product from the local database
const product = await getProductByUuid(uuid);

// If the product doesn't exist, redirect
if (!product) {
  return Astro.redirect('/en/products');
}
---

<ProductDetail product={product} lang="en" />
