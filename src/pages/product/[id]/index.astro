---
import ProductDetail from "@/components/shared/ProductDetail.astro";
import { getProductByUuid, ensureProductSlugs } from "@/lib/product-service";
import { getProductById } from "@/lib/database";
import { urlDeProducto } from "@/lib/product-url";

// Obtener UUID del producto de la URL
const { id: uuid } = Astro.params;

// Verificar que el ID sea válido
if (!uuid || typeof uuid !== 'string') {
  return Astro.redirect('/productos');
}

// Obtener producto desde la base de datos local
const product = await getProductByUuid(uuid);

// Si no existe el producto, redirigir
if (!product) {
  return Astro.redirect('/productos');
}

// Ruta vieja. La ficha vive ahora en /productos/<slug>: aquí solo se
// redirige (301, para que buscadores y enlaces compartidos se actualicen).
// Una medida suelta (variant-N) manda a su producto completo, que es la
// ficha donde sí se puede cambiar de tamaño.
await ensureProductSlugs();
if (product.uuid.startsWith('variant-') && (product as any).product_id) {
  const padre = await getProductById(Number((product as any).product_id));
  if (padre?.slug) return Astro.redirect(urlDeProducto(padre, 'es'), 301);
}
if (product.slug) {
  return Astro.redirect(urlDeProducto(product, 'es'), 301);
}
---

<ProductDetail product={product} lang="es" />
