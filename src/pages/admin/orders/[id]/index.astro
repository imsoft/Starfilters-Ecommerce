---
import AdminLayout from "@/layouts/adminLayout.astro";
import { ZONA_HORARIA } from "@/lib/timezone";
import { getOrderByUuid, getOrderItems, getOrderStatusHistory, setOrderCfdiStamped } from "@/lib/database";
import { changeOrderStatus } from "@/lib/order-status";
import { getDeliveryOption, getDeliveryLabel, isPickupMethod } from "@/lib/delivery-options";
import { getOrderNotificationEmails } from "@/lib/site-settings-service";
import { infoEstado, siguientePaso as calcularSiguientePaso, necesitaGuia as requiereGuia } from "@/lib/order-status-ui";
import type { DeliveryMethod } from "@/lib/delivery-options";
import { requireAdmin } from "@/lib/auth-utils";

export const prerender = false;

// Solo administradores: la comprobación va ANTES de procesar el POST.
const { redirect: redirigirSiNoEsAdmin, user: adminUser } = await requireAdmin(Astro.cookies);
if (redirigirSiNoEsAdmin) {
  return Astro.redirect(redirigirSiNoEsAdmin);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/orders?error=invalid_id');
}

let order = await getOrderByUuid(id);
if (!order) {
  return Astro.redirect('/admin/orders?error=order_not_found');
}

// --- Cambio de estado -------------------------------------------------------
// Todo pasa por changeOrderStatus, la misma función que usa la API: guarda el
// estado, guarda la guía y avisa al cliente.
let errorAccion: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  // Timbrado del CFDI: es una acción aparte, no un cambio de estado del pedido.
  const accion = String(formData.get('accion') || '');
  if (accion === 'cfdi') {
    const timbrado = formData.get('timbrado') === '1';
    await setOrderCfdiStamped(order.id, timbrado);
    return Astro.redirect(`/admin/orders/${id}?ok=1`);
  }

  const nuevoEstado = String(formData.get('status') || '');
  const carrier = formData.get('carrier');
  const trackingNumber = formData.get('tracking_number');
  // La casilla solo llega en el formulario cuando está marcada.
  const avisar = formData.get('notify') !== null;

  const resultado = await changeOrderStatus({
    orderId: order.id,
    newStatus: nuevoEstado,
    carrier: carrier !== null ? String(carrier).trim() : undefined,
    trackingNumber: trackingNumber !== null ? String(trackingNumber).trim() : undefined,
    notify: avisar,
    changedBy: [adminUser?.firstName, adminUser?.lastName].filter(Boolean).join(' ') || adminUser?.email || null,
  });

  if (resultado.ok) {
    return Astro.redirect(`/admin/orders/${id}?ok=1`);
  }

  errorAccion = resultado.reason === 'invalid_status'
    ? 'Ese estado no existe.'
    : 'No se pudo guardar el cambio. Intenta de nuevo.';
}

const guardado = Astro.url.searchParams.get('ok') === '1';

const orderItems = await getOrderItems(order.id);

// Datos fiscales: se guardan como JSON y solo existen si el cliente pidió
// factura. MySQL puede devolverlos ya parseados o como texto.
let billing: Record<string, string> | null = null;
if (order.billing_data) {
  try {
    billing = typeof order.billing_data === 'string'
      ? JSON.parse(order.billing_data)
      : order.billing_data as any;
  } catch (error) {
    console.error('⚠️ billing_data ilegible en la orden', order.order_number, error);
  }
}

const billingFields: Array<{ label: string; value?: string }> = billing ? [
  { label: 'Razón social', value: billing.businessName },
  { label: 'RFC', value: billing.rfc },
  { label: 'Régimen fiscal', value: billing.taxRegime },
  { label: 'Uso de CFDI', value: billing.cfdiUse },
  { label: 'Código postal fiscal', value: billing.postalCode },
  { label: 'Enviar la factura a', value: billing.email },
].filter(f => f.value) : [];

const requiereFactura = billingFields.length > 0;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    timeZone: ZONA_HORARIA,
    day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
  }).format(new Date(date));
}

// Los pedidos pueden estar en pesos o en dólares (el sitio en inglés cobra en
// USD), así que el importe se formatea con la moneda de cada orden.
function formatCurrency(amount: number, currency: string = 'MXN'): string {
  const moneda = currency === 'USD' ? 'USD' : 'MXN';
  return new Intl.NumberFormat(moneda === 'USD' ? 'en-US' : 'es-MX', {
    style: 'currency', currency: moneda,
  }).format(amount) + ` ${moneda}`;
}

const estadoActual = infoEstado(order.status);
const cancelada = order.status === 'cancelled';

// --- Entrega ----------------------------------------------------------------
// delivery_method es nuevo: las órdenes anteriores no lo tienen y hay que
// decirlo en vez de inventar una forma de entrega.
const metodo = (order.delivery_method || null) as DeliveryMethod | null;
const opcionEntrega = metodo ? getDeliveryOption(metodo) : undefined;
const etiquetaEntrega = metodo ? getDeliveryLabel(metodo) : 'No registrada';
const esRecoger = metodo ? isPickupMethod(metodo) : false;
const plazoEntrega = opcionEntrega?.days.es || '';
const direccionSucursal = opcionEntrega?.address?.text || '';
// Solo la paquetería nacional necesita guía; el reparto propio y las
// recolecciones no tienen número que capturar.
const necesitaGuia = requiereGuia(metodo);

// --- Seguimiento ------------------------------------------------------------
// Solo se guarda el estado actual y su fecha de cambio, así que el hito
// alcanzado lleva fecha y los siguientes no.
const ORDEN_ESTADOS = ['pending', 'processing', 'shipped', 'delivered'];
const indiceActual = ORDEN_ESTADOS.indexOf(order.status);

// Historial real: cada avance guarda cuándo y quién lo marcó. Los pedidos
// anteriores a esta tabla no tienen filas, así que su seguimiento solo puede
// fechar el primer hito y el actual.
const historial = await getOrderStatusHistory(order.id);
const historialPorEstado = new Map(historial.map((fila) => [fila.to_status, fila]));

const hitos = [
  { clave: 'pending',    titulo: 'Pago confirmado',  detalle: 'Orden creada e inventario descontado' },
  { clave: 'processing', titulo: 'En preparación',   detalle: 'Se está surtiendo del almacén' },
  { clave: 'shipped',    titulo: esRecoger ? 'Listo para recoger' : 'Enviado', detalle: esRecoger ? 'El cliente puede pasar por él' : 'Salió a entrega' },
  { clave: 'delivered',  titulo: 'Entregado',        detalle: 'Pedido cerrado' },
].map((hito, i) => {
  const fila = historialPorEstado.get(hito.clave);
  const cumplido = !cancelada && i <= indiceActual;
  return {
    ...hito,
    cumplido,
    // El pago no pasa por el historial: ocurrió al crearse la orden.
    fecha: i === 0
      ? formatDate(order.created_at)
      : fila
        ? formatDate(fila.created_at)
        : (cumplido && i === indiceActual ? formatDate(order.updated_at) : ''),
    porQuien: fila?.changed_by || null,
  };
});

// Para poder marcar o abrir WhatsApp desde el panel hay que quitarle al número
// los espacios y guiones que el cliente haya escrito. WhatsApp además exige la
// lada del país, así que a un número mexicano de 10 dígitos se le antepone 52.
const telefonoLimpio = (order.customer_phone || '').replace(/[^\d+]/g, '');
const soloDigitos = telefonoLimpio.replace(/\D/g, '');
const telefonoWhatsapp = soloDigitos.length === 10 ? `52${soloDigitos}` : soloDigitos;

const cfdiTimbrado = Boolean(order.cfdi_stamped_at);

// Quiénes reciben el aviso al avanzar el pedido, para decirlo en la pantalla y
// no dejar al admin adivinando a dónde va el correo.
const correosAviso = await getOrderNotificationEmails();

// --- Siguiente paso ---------------------------------------------------------
const siguientePaso = cancelada ? null : calcularSiguientePaso(order.status, { esRecoger, necesitaGuia });


const subtotal = orderItems.reduce((suma, item) => suma + Number(item.price) * item.quantity, 0);

// Desglose: el guardado o, en pedidos viejos, el reconstruido desde el total
// con la misma regla del cobro (lib/order-breakdown.ts). Es lo mismo que ve
// el cliente en su página, para que las dos pantallas cuenten la misma
// historia.
const desgloseOrden = desgloseDeOrden({
  subtotalRenglones: subtotal,
  total: order.total_amount,
  guardado: {
    subtotal: order.subtotal_amount,
    discount: order.discount_amount,
    shipping: order.shipping_amount,
    tax: order.tax_amount,
  },
  descuentoRegistrado: await getOrderDiscountAmount(order.id),
});
const desglose = {
  subtotal: desgloseOrden?.subtotal ?? null,
  discount: desgloseOrden?.discount ?? null,
  shipping: desgloseOrden?.shipping ?? null,
  tax: desgloseOrden?.tax ?? null,
};
const hayDesglose = desgloseOrden !== null;
const diferenciaSinDesglose = Number(order.total_amount) - subtotal;
import { desgloseDeOrden } from '@/lib/order-breakdown';
import { getOrderDiscountAmount } from '@/lib/database';
---
<AdminLayout title={`Orden ${order.order_number}`}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    {guardado && (
      <div class="mb-6 flex gap-3 rounded-lg border border-green-300 bg-green-50 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <p class="text-sm font-medium text-green-800">Cambio guardado.</p>
      </div>
    )}

    {errorAccion && (
      <div class="mb-6 flex gap-3 rounded-lg border border-red-300 bg-red-50 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <p class="text-sm font-medium text-red-800">{errorAccion}</p>
      </div>
    )}

    <!-- Encabezado -->
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="mb-1.5 flex flex-wrap items-center gap-2.5">
          <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{order.order_number}</h1>
          <span class={`rounded-full px-3 py-1 text-xs font-semibold ${estadoActual.badge}`}>{estadoActual.etiqueta}</span>
        </div>
        <p class="text-sm text-muted-foreground">
          {order.customer_name} · {order.customer_email}{order.customer_phone && ` · ${order.customer_phone}`}
        </p>
      </div>
      <a href="/admin/orders" class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Volver a órdenes
      </a>
    </div>

    <!-- Franja de operación: lo que decide el trabajo, antes que el detalle -->
    <div class="mb-7 grid grid-cols-2 overflow-hidden rounded-lg border border-border lg:grid-cols-4">
      <div class="border-b border-r border-border p-4 lg:border-b-0">
        <p class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Entrega</p>
        <p class="text-sm font-semibold text-foreground">{etiquetaEntrega}</p>
      </div>
      <div class="border-b border-border p-4 lg:border-b-0 lg:border-r">
        <p class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Plazo prometido</p>
        <p class="text-sm font-semibold text-foreground">{plazoEntrega || '—'}</p>
      </div>
      <div class="border-r border-border p-4">
        <p class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Factura</p>
        <p class={`text-sm font-semibold ${requiereFactura ? (cfdiTimbrado ? 'text-green-700' : 'text-amber-700') : 'text-foreground'}`}>
          {requiereFactura ? (cfdiTimbrado ? 'Timbrada' : 'Sí, CFDI pendiente') : 'No solicitó'}
        </p>
      </div>
      <div class="p-4">
        <p class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Total cobrado</p>
        <p class="text-sm font-semibold text-foreground">{formatCurrency(order.total_amount, order.currency)}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 items-start gap-7 lg:grid-cols-[1fr_22rem]">

      <div class="space-y-6">

        <!-- Seguimiento -->
        <div class="rounded-lg border border-border p-6">
          <h2 class="mb-6 text-lg font-semibold text-foreground">Seguimiento</h2>

          {cancelada ? (
            <div class="rounded-lg bg-red-50 p-4">
              <p class="text-sm font-semibold text-red-800">Pedido cancelado</p>
              <p class="mt-1 text-sm text-red-700">{formatDate(order.updated_at)}</p>
            </div>
          ) : (
            <div>
              {hitos.map((hito, i) => (
                <div class="grid grid-cols-[1.5rem_1fr] gap-4">
                  <div class="flex flex-col items-center">
                    {hito.cumplido ? (
                      <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-green-500">
                        <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"></path>
                        </svg>
                      </span>
                    ) : (
                      <span class="h-6 w-6 flex-shrink-0 rounded-full border-2 border-border bg-background"></span>
                    )}
                    {i < hitos.length - 1 && (
                      <span class={`w-0.5 flex-1 ${hito.cumplido ? 'bg-green-500' : 'bg-border'}`} style="min-height: 26px;"></span>
                    )}
                  </div>
                  <div class={i < hitos.length - 1 ? 'pb-5' : ''}>
                    <p class={`text-sm font-semibold ${hito.cumplido ? 'text-foreground' : 'text-muted-foreground'}`}>{hito.titulo}</p>
                    <p class="mt-0.5 text-sm text-muted-foreground">
                      {hito.fecha ? hito.fecha : hito.cumplido ? hito.detalle : 'Pendiente'}
                      {hito.porQuien && ` · ${hito.porQuien}`}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )}

          {order.tracking_number && (
            <div class="mt-5 rounded-lg bg-muted p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Guía</p>
              <p class="mt-1.5 text-sm font-semibold text-foreground">
                {order.shipping_carrier ? `${order.shipping_carrier} · ` : ''}{order.tracking_number}
              </p>
            </div>
          )}
        </div>

        <!-- Siguiente paso -->
        {siguientePaso && (
          <form method="POST" class="rounded-lg border border-primary bg-primary/5 p-6">
            <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Siguiente paso</p>
            <h2 class="mb-1.5 text-lg font-semibold text-foreground">{siguientePaso.titulo}</h2>
            <p class="mb-5 text-sm leading-relaxed text-muted-foreground">{siguientePaso.explicacion}</p>

            <input type="hidden" name="status" value={siguientePaso.estado} />

            {necesitaGuia && siguientePaso.estado === 'shipped' && (
              <div class="mb-4 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
                <div>
                  <label for="carrier" class="mb-1.5 block text-sm font-semibold text-foreground">Paquetería</label>
                  <input
                    type="text"
                    id="carrier"
                    name="carrier"
                    value={order.shipping_carrier || ''}
                    placeholder="Estafeta, FedEx, DHL…"
                    class="block w-full rounded-md border border-border px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label for="tracking_number" class="mb-1.5 block text-sm font-semibold text-foreground">Número de guía</label>
                  <input
                    type="text"
                    id="tracking_number"
                    name="tracking_number"
                    value={order.tracking_number || ''}
                    placeholder="794512338001"
                    class="block w-full rounded-md border border-border px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>
            )}

            <label class="mb-2 flex items-center gap-2.5 text-sm text-foreground">
              <input type="checkbox" name="notify" checked class="h-4 w-4 rounded border-border text-primary focus:ring-primary" />
              Avisar por correo
            </label>
            <ul class="mb-5 space-y-1 text-xs text-muted-foreground">
              <li>
                Al cliente: <span class="font-medium text-foreground">{order.customer_email}</span>
              </li>
              <li>
                Al equipo:{' '}
                {correosAviso.length > 0
                  ? <span class="font-medium text-foreground">{correosAviso.join(', ')}</span>
                  : <span>sin correos configurados</span>}
                {' · '}
                <a href="/admin/settings/notificaciones" class="font-medium text-primary hover:underline">Editar</a>
              </li>
            </ul>

            <div class="flex flex-wrap gap-2.5">
              <button type="submit" class="rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
                {siguientePaso.boton}
              </button>
            </div>
          </form>
        )}

        <!-- Correcciones: regresar o cancelar -->
        {!cancelada && (
          <div class="rounded-lg border border-border p-5">
            <p class="mb-3.5 text-sm font-semibold text-foreground">¿Marcaste algo por error?</p>
            <div class="flex flex-wrap gap-2.5">
              {order.status !== 'pending' && (
                <form method="POST">
                  <input type="hidden" name="status" value={ORDEN_ESTADOS[Math.max(indiceActual - 1, 0)]} />
                  <button type="submit" class="rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
                    Regresar al paso anterior
                  </button>
                </form>
              )}
              <form method="POST">
                <input type="hidden" name="status" value="cancelled" />
                <input type="hidden" name="notify" value="on" />
                <button type="submit" class="rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 transition-colors hover:bg-red-50">
                  Cancelar pedido
                </button>
              </form>
            </div>
            <p class="mt-3 text-xs text-muted-foreground">
              Regresar un paso no manda ningún aviso. Cancelar sí avisa al cliente y al equipo.
            </p>
          </div>
        )}

        <!-- Productos -->
        <div class="rounded-lg border border-border p-6">
          <h2 class="mb-4 text-lg font-semibold text-foreground">Qué se prepara</h2>
          {orderItems.length === 0 ? (
            <p class="py-6 text-center text-sm text-muted-foreground">Esta orden no tiene productos registrados.</p>
          ) : (
            <div class="space-y-3">
              {orderItems.map((item) => (
                <div class="flex items-center gap-4">
                  {item.image_url ? (
                    <img class="h-12 w-12 flex-shrink-0 rounded-md object-cover" src={item.image_url} alt={item.product_name} loading="lazy" />
                  ) : (
                    <span class="h-12 w-12 flex-shrink-0 rounded-md bg-muted"></span>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-foreground">{item.product_name}</p>
                    <p class="mt-0.5 text-sm text-muted-foreground">{formatCurrency(item.price, order.currency)} c/u</p>
                  </div>
                  <p class="text-base font-semibold text-foreground">×{item.quantity}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Columna lateral -->
      <div class="space-y-4">

        <div class="overflow-hidden rounded-lg border border-border">
          <div class="border-b border-border bg-muted px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {esRecoger ? 'Recoge en' : 'Enviar a'}
            </p>
          </div>
          <div class="p-4">
            {esRecoger ? (
              <p class="text-sm leading-relaxed text-muted-foreground">{direccionSucursal || 'Sucursal no registrada'}</p>
            ) : (
              <div>
                <p class="mb-1.5 text-sm font-semibold text-foreground">{order.customer_name}</p>
                <p class="text-sm leading-relaxed text-muted-foreground">{order.shipping_address || 'Sin dirección registrada'}</p>
              </div>
            )}
            <div class="mt-3 border-t border-border pt-3">
              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Teléfono</p>
              {order.customer_phone ? (
                <div class="flex flex-wrap items-center gap-2">
                  <a href={`tel:${telefonoLimpio}`} class="text-sm font-semibold text-foreground hover:text-primary">
                    {order.customer_phone}
                  </a>
                  <a
                    href={`https://wa.me/${telefonoWhatsapp}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-md bg-[#25D366] px-2.5 py-1 text-xs font-semibold text-white transition hover:bg-[#1ebe5d]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
                    </svg>
                    WhatsApp
                  </a>
                </div>
              ) : (
                <p class="text-sm text-muted-foreground">
                  No lo capturó. Escríbele a
                  <a href={`mailto:${order.customer_email}`} class="font-medium text-primary hover:underline"> {order.customer_email}</a>.
                </p>
              )}
            </div>
          </div>
        </div>

        {requiereFactura ? (
          <div class={`overflow-hidden rounded-xl border ${cfdiTimbrado ? 'border-green-200 bg-green-50' : 'border-amber-200 bg-amber-50'}`}>
            <div class={`border-b px-4 py-3.5 ${cfdiTimbrado ? 'border-green-200' : 'border-amber-200'}`}>
              <p class={`text-xs font-semibold uppercase tracking-wider ${cfdiTimbrado ? 'text-green-800' : 'text-amber-800'}`}>
                {cfdiTimbrado ? 'Factura timbrada' : 'Requiere factura'}
              </p>
            </div>
            <div class="space-y-2.5 p-4">
              {billingFields.map((field) => (
                <div class="flex justify-between gap-3">
                  <span class={`text-xs ${cfdiTimbrado ? 'text-green-900' : 'text-amber-900'}`}>{field.label}</span>
                  <span class="text-right text-sm font-semibold text-foreground">{field.value}</span>
                </div>
              ))}

              <div class={`border-t pt-3 ${cfdiTimbrado ? 'border-green-200' : 'border-amber-200'}`}>
                {cfdiTimbrado ? (
                  <div>
                    <p class="mb-2.5 text-xs text-green-900">Timbrada el {formatDate(order.cfdi_stamped_at!)}</p>
                    <form method="POST">
                      <input type="hidden" name="accion" value="cfdi" />
                      <input type="hidden" name="timbrado" value="0" />
                      <button type="submit" class="w-full rounded-md border border-green-300 bg-white px-4 py-2 text-sm font-semibold text-green-800 transition-colors hover:bg-green-100">
                        Marcar como pendiente
                      </button>
                    </form>
                  </div>
                ) : (
                  <form method="POST">
                    <input type="hidden" name="accion" value="cfdi" />
                    <input type="hidden" name="timbrado" value="1" />
                    <button type="submit" class="w-full rounded-md bg-amber-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-amber-700">
                      Marcar CFDI como timbrado
                    </button>
                  </form>
                )}
              </div>
            </div>
          </div>
        ) : (
          <div class="rounded-lg border border-border p-4">
            <p class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Facturación</p>
            <p class="text-sm leading-relaxed text-muted-foreground">Este pedido no solicitó factura.</p>
          </div>
        )}

        <div class="rounded-lg border border-border p-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Resumen</p>
          <div class="space-y-2.5">
            <div class="flex justify-between">
              <span class="text-sm text-muted-foreground">Productos</span>
              <span class="text-sm text-foreground">{formatCurrency(hayDesglose ? (desglose.subtotal as number) : subtotal, order.currency)}</span>
            </div>
            {hayDesglose ? (
              <>
                {desglose.discount !== null && desglose.discount > 0 && (
                  <div class="flex justify-between">
                    <span class="text-sm text-muted-foreground">Descuento</span>
                    <span class="text-sm text-green-700">-{formatCurrency(desglose.discount, order.currency)}</span>
                  </div>
                )}
                <div class="flex justify-between">
                  <span class="text-sm text-muted-foreground">Envío</span>
                  <span class="text-sm text-foreground">{desglose.shipping ? formatCurrency(desglose.shipping, order.currency) : 'Gratis'}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-sm text-muted-foreground">IVA (16%)</span>
                  <span class="text-sm text-foreground">{formatCurrency(desglose.tax ?? 0, order.currency)}</span>
                </div>
              </>
            ) : diferenciaSinDesglose > 0.5 ? (
              <div class="flex justify-between">
                <span class="text-sm text-muted-foreground">Envío e impuestos</span>
                <span class="text-sm text-foreground">{formatCurrency(diferenciaSinDesglose, order.currency)}</span>
              </div>
            ) : null}
            <div class="flex justify-between border-t border-border pt-2.5">
              <span class="text-sm font-bold text-foreground">Total cobrado</span>
              <span class="text-sm font-bold text-foreground">{formatCurrency(order.total_amount, order.currency)}</span>
            </div>
          </div>
          <p class="mt-3 text-xs text-muted-foreground">Creada el {formatDate(order.created_at)}</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
