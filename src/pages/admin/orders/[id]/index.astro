---
import AdminLayout from "@/layouts/adminLayout.astro";
import { getOrderByUuid, getOrderItems } from "@/lib/database";
import { changeOrderStatus } from "@/lib/order-status";
import { getDeliveryOption, getDeliveryLabel, isPickupMethod } from "@/lib/delivery-options";
import type { DeliveryMethod } from "@/lib/delivery-options";
import { requireAdmin } from "@/lib/auth-utils";

export const prerender = false;

// Solo administradores: la comprobación va ANTES de procesar el POST.
const { redirect: redirigirSiNoEsAdmin } = await requireAdmin(Astro.cookies);
if (redirigirSiNoEsAdmin) {
  return Astro.redirect(redirigirSiNoEsAdmin);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/orders?error=invalid_id');
}

let order = await getOrderByUuid(id);
if (!order) {
  return Astro.redirect('/admin/orders?error=order_not_found');
}

// --- Cambio de estado -------------------------------------------------------
// Todo pasa por changeOrderStatus, la misma función que usa la API: guarda el
// estado, guarda la guía y avisa al cliente.
let errorAccion: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const nuevoEstado = String(formData.get('status') || '');
  const carrier = formData.get('carrier');
  const trackingNumber = formData.get('tracking_number');
  // La casilla solo llega en el formulario cuando está marcada.
  const avisar = formData.get('notify') !== null;

  const resultado = await changeOrderStatus({
    orderId: order.id,
    newStatus: nuevoEstado,
    carrier: carrier !== null ? String(carrier).trim() : undefined,
    trackingNumber: trackingNumber !== null ? String(trackingNumber).trim() : undefined,
    notifyCustomer: avisar,
  });

  if (resultado.ok) {
    return Astro.redirect(`/admin/orders/${id}?ok=1`);
  }

  errorAccion = resultado.reason === 'invalid_status'
    ? 'Ese estado no existe.'
    : 'No se pudo guardar el cambio. Intenta de nuevo.';
}

const guardado = Astro.url.searchParams.get('ok') === '1';

const orderItems = await getOrderItems(order.id);

// Datos fiscales: se guardan como JSON y solo existen si el cliente pidió
// factura. MySQL puede devolverlos ya parseados o como texto.
let billing: Record<string, string> | null = null;
if (order.billing_data) {
  try {
    billing = typeof order.billing_data === 'string'
      ? JSON.parse(order.billing_data)
      : order.billing_data as any;
  } catch (error) {
    console.error('⚠️ billing_data ilegible en la orden', order.order_number, error);
  }
}

const billingFields: Array<{ label: string; value?: string }> = billing ? [
  { label: 'Razón social', value: billing.businessName },
  { label: 'RFC', value: billing.rfc },
  { label: 'Régimen fiscal', value: billing.taxRegime },
  { label: 'Uso de CFDI', value: billing.cfdiUse },
  { label: 'Código postal fiscal', value: billing.postalCode },
  { label: 'Enviar la factura a', value: billing.email },
].filter(f => f.value) : [];

const requiereFactura = billingFields.length > 0;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('es-MX', {
    day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
  }).format(new Date(date));
}

// Los pedidos pueden estar en pesos o en dólares (el sitio en inglés cobra en
// USD), así que el importe se formatea con la moneda de cada orden.
function formatCurrency(amount: number, currency: string = 'MXN'): string {
  const moneda = currency === 'USD' ? 'USD' : 'MXN';
  return new Intl.NumberFormat(moneda === 'USD' ? 'en-US' : 'es-MX', {
    style: 'currency', currency: moneda,
  }).format(amount) + ` ${moneda}`;
}

const ESTADOS: Record<string, { texto: string; badge: string }> = {
  pending:    { texto: 'Pendiente',      badge: 'bg-yellow-100 text-yellow-800' },
  processing: { texto: 'En preparación', badge: 'bg-blue-100 text-blue-800' },
  shipped:    { texto: 'Enviado',        badge: 'bg-purple-100 text-purple-800' },
  delivered:  { texto: 'Entregado',      badge: 'bg-green-100 text-green-800' },
  cancelled:  { texto: 'Cancelado',      badge: 'bg-red-100 text-red-800' },
};

const estadoActual = ESTADOS[order.status] || { texto: order.status, badge: 'bg-gray-100 text-gray-800' };
const cancelada = order.status === 'cancelled';

// --- Entrega ----------------------------------------------------------------
// delivery_method es nuevo: las órdenes anteriores no lo tienen y hay que
// decirlo en vez de inventar una forma de entrega.
const metodo = (order.delivery_method || null) as DeliveryMethod | null;
const opcionEntrega = metodo ? getDeliveryOption(metodo) : undefined;
const etiquetaEntrega = metodo ? getDeliveryLabel(metodo) : 'No registrada';
const esRecoger = metodo ? isPickupMethod(metodo) : false;
const plazoEntrega = opcionEntrega?.days.es || '';
const direccionSucursal = opcionEntrega?.address?.text || '';
// Solo la paquetería nacional necesita guía; el reparto propio y las
// recolecciones no tienen número que capturar.
const necesitaGuia = metodo === 'paqueteria';

// --- Seguimiento ------------------------------------------------------------
// Solo se guarda el estado actual y su fecha de cambio, así que el hito
// alcanzado lleva fecha y los siguientes no.
const ORDEN_ESTADOS = ['pending', 'processing', 'shipped', 'delivered'];
const indiceActual = ORDEN_ESTADOS.indexOf(order.status);

const hitos = [
  { clave: 'pending',    titulo: 'Pago confirmado',  detalle: 'Orden creada e inventario descontado' },
  { clave: 'processing', titulo: 'En preparación',   detalle: 'Se está surtiendo del almacén' },
  { clave: 'shipped',    titulo: esRecoger ? 'Listo para recoger' : 'Enviado', detalle: esRecoger ? 'El cliente puede pasar por él' : 'Salió a entrega' },
  { clave: 'delivered',  titulo: 'Entregado',        detalle: 'Pedido cerrado' },
].map((hito, i) => ({
  ...hito,
  cumplido: !cancelada && i <= indiceActual,
  esActual: !cancelada && i === indiceActual,
  // El primer hito ocurrió al crearse la orden; el actual, en el último cambio.
  fecha: i === 0
    ? formatDate(order.created_at)
    : (!cancelada && i === indiceActual ? formatDate(order.updated_at) : ''),
}));

// --- Siguiente paso ---------------------------------------------------------
const SIGUIENTE: Record<string, { estado: string; titulo: string; boton: string; explicacion: string }> = {
  pending: {
    estado: 'processing',
    titulo: 'Marcar en preparación',
    boton: 'Empezar a preparar',
    explicacion: 'Avisa al cliente que ya se está surtiendo su pedido.',
  },
  processing: {
    estado: 'shipped',
    titulo: esRecoger ? 'Marcar como listo para recoger' : 'Marcar como enviado',
    boton: esRecoger ? 'Marcar listo' : 'Confirmar envío',
    explicacion: esRecoger
      ? 'Avisa al cliente que ya puede pasar por su pedido a la sucursal.'
      : necesitaGuia
        ? 'Se le manda al cliente un correo con la paquetería y el número de guía.'
        : 'Avisa al cliente que su pedido va en camino.',
  },
  shipped: {
    estado: 'delivered',
    titulo: 'Cerrar el pedido',
    boton: 'Marcar como entregado',
    explicacion: 'Confirma que el cliente ya recibió su pedido.',
  },
};

const siguientePaso = cancelada ? null : SIGUIENTE[order.status] || null;

const subtotal = orderItems.reduce((suma, item) => suma + item.price * item.quantity, 0);
---
<AdminLayout title={`Orden ${order.order_number}`}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    {guardado && (
      <div class="mb-6 flex gap-3 rounded-lg border border-green-300 bg-green-50 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-green-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <p class="text-sm font-medium text-green-800">Cambio guardado.</p>
      </div>
    )}

    {errorAccion && (
      <div class="mb-6 flex gap-3 rounded-lg border border-red-300 bg-red-50 p-4">
        <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <p class="text-sm font-medium text-red-800">{errorAccion}</p>
      </div>
    )}

    <!-- Encabezado -->
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="mb-1.5 flex flex-wrap items-center gap-2.5">
          <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">{order.order_number}</h1>
          <span class={`rounded-full px-3 py-1 text-xs font-semibold ${estadoActual.badge}`}>{estadoActual.texto}</span>
        </div>
        <p class="text-sm text-muted-foreground">
          {order.customer_name} · {order.customer_email}{order.customer_phone && ` · ${order.customer_phone}`}
        </p>
      </div>
      <a href="/admin/orders" class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Volver a órdenes
      </a>
    </div>

    <!-- Franja de operación: lo que decide el trabajo, antes que el detalle -->
    <div class="mb-7 grid grid-cols-2 overflow-hidden rounded-xl border border-border lg:grid-cols-4">
      <div class="border-b border-r border-border p-4 lg:border-b-0">
        <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Entrega</p>
        <p class="text-sm font-semibold text-foreground">{etiquetaEntrega}</p>
      </div>
      <div class="border-b border-border p-4 lg:border-b-0 lg:border-r">
        <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Plazo prometido</p>
        <p class="text-sm font-semibold text-foreground">{plazoEntrega || '—'}</p>
      </div>
      <div class="border-r border-border p-4">
        <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Factura</p>
        <p class={`text-sm font-semibold ${requiereFactura ? 'text-amber-700' : 'text-foreground'}`}>
          {requiereFactura ? 'Sí, requiere CFDI' : 'No solicitó'}
        </p>
      </div>
      <div class="p-4">
        <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Total cobrado</p>
        <p class="text-sm font-semibold text-foreground">{formatCurrency(order.total_amount, order.currency)}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 items-start gap-7 lg:grid-cols-[1fr_22rem]">

      <div class="space-y-6">

        <!-- Seguimiento -->
        <div class="rounded-xl border border-border p-6">
          <h2 class="mb-6 text-[17px] font-bold tracking-tight text-foreground">Seguimiento</h2>

          {cancelada ? (
            <div class="rounded-lg bg-red-50 p-4">
              <p class="text-sm font-semibold text-red-800">Pedido cancelado</p>
              <p class="mt-1 text-sm text-red-700">{formatDate(order.updated_at)}</p>
            </div>
          ) : (
            <div>
              {hitos.map((hito, i) => (
                <div class="grid grid-cols-[28px_1fr] gap-4">
                  <div class="flex flex-col items-center">
                    {hito.cumplido ? (
                      <span class="flex h-[26px] w-[26px] flex-shrink-0 items-center justify-center rounded-full bg-green-500">
                        <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"></path>
                        </svg>
                      </span>
                    ) : (
                      <span class="h-[26px] w-[26px] flex-shrink-0 rounded-full border-2 border-border bg-background"></span>
                    )}
                    {i < hitos.length - 1 && (
                      <span class={`w-0.5 flex-1 ${hito.cumplido ? 'bg-green-500' : 'bg-border'}`} style="min-height: 26px;"></span>
                    )}
                  </div>
                  <div class={i < hitos.length - 1 ? 'pb-5' : ''}>
                    <p class={`text-sm font-semibold ${hito.cumplido ? 'text-foreground' : 'text-muted-foreground'}`}>{hito.titulo}</p>
                    <p class="mt-0.5 text-[13px] text-muted-foreground">
                      {hito.fecha ? hito.fecha : hito.cumplido ? hito.detalle : 'Pendiente'}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )}

          {order.tracking_number && (
            <div class="mt-5 rounded-lg bg-muted p-4">
              <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Guía</p>
              <p class="mt-1.5 text-sm font-semibold text-foreground">
                {order.shipping_carrier ? `${order.shipping_carrier} · ` : ''}{order.tracking_number}
              </p>
            </div>
          )}
        </div>

        <!-- Siguiente paso -->
        {siguientePaso && (
          <form method="POST" class="rounded-xl border-2 border-foreground p-6">
            <p class="mb-1 text-[11px] font-bold uppercase tracking-[0.1em] text-muted-foreground">Siguiente paso</p>
            <h2 class="mb-1.5 text-lg font-bold tracking-tight text-foreground">{siguientePaso.titulo}</h2>
            <p class="mb-5 text-sm leading-relaxed text-muted-foreground">{siguientePaso.explicacion}</p>

            <input type="hidden" name="status" value={siguientePaso.estado} />

            {necesitaGuia && siguientePaso.estado === 'shipped' && (
              <div class="mb-4 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
                <div>
                  <label for="carrier" class="mb-1.5 block text-[13px] font-semibold text-foreground">Paquetería</label>
                  <input
                    type="text"
                    id="carrier"
                    name="carrier"
                    value={order.shipping_carrier || ''}
                    placeholder="Estafeta, FedEx, DHL…"
                    class="block w-full rounded-md border border-border px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label for="tracking_number" class="mb-1.5 block text-[13px] font-semibold text-foreground">Número de guía</label>
                  <input
                    type="text"
                    id="tracking_number"
                    name="tracking_number"
                    value={order.tracking_number || ''}
                    placeholder="794512338001"
                    class="block w-full rounded-md border border-border px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>
            )}

            <label class="mb-5 flex items-center gap-2.5 text-sm text-foreground">
              <input type="checkbox" name="notify" checked class="h-4 w-4 rounded border-border text-primary focus:ring-primary" />
              Avisarle a {order.customer_name.split(' ')[0]} por correo
            </label>

            <div class="flex flex-wrap gap-2.5">
              <button type="submit" class="rounded-md bg-foreground px-5 py-2.5 text-sm font-semibold text-background transition-opacity hover:opacity-90">
                {siguientePaso.boton}
              </button>
            </div>
          </form>
        )}

        <!-- Correcciones: regresar o cancelar -->
        {!cancelada && (
          <div class="rounded-xl border border-border p-5">
            <p class="mb-3.5 text-[13px] font-semibold text-foreground">¿Marcaste algo por error?</p>
            <div class="flex flex-wrap gap-2.5">
              {order.status !== 'pending' && (
                <form method="POST">
                  <input type="hidden" name="status" value={ORDEN_ESTADOS[Math.max(indiceActual - 1, 0)]} />
                  <button type="submit" class="rounded-md border border-border px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted">
                    Regresar al paso anterior
                  </button>
                </form>
              )}
              <form method="POST">
                <input type="hidden" name="status" value="cancelled" />
                <input type="hidden" name="notify" value="on" />
                <button type="submit" class="rounded-md border border-red-200 px-4 py-2 text-sm font-semibold text-red-700 transition-colors hover:bg-red-50">
                  Cancelar pedido
                </button>
              </form>
            </div>
            <p class="mt-3 text-xs text-muted-foreground">
              Regresar un paso no le manda correo al cliente. Cancelar sí le avisa.
            </p>
          </div>
        )}

        <!-- Productos -->
        <div class="rounded-xl border border-border p-6">
          <h2 class="mb-4 text-[17px] font-bold tracking-tight text-foreground">Qué se prepara</h2>
          {orderItems.length === 0 ? (
            <p class="py-6 text-center text-sm text-muted-foreground">Esta orden no tiene productos registrados.</p>
          ) : (
            <div class="space-y-3">
              {orderItems.map((item) => (
                <div class="flex items-center gap-4">
                  {item.image_url ? (
                    <img class="h-12 w-12 flex-shrink-0 rounded-md object-cover" src={item.image_url} alt={item.product_name} loading="lazy" />
                  ) : (
                    <span class="h-12 w-12 flex-shrink-0 rounded-md bg-muted"></span>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-foreground">{item.product_name}</p>
                    <p class="mt-0.5 text-[13px] text-muted-foreground">{formatCurrency(item.price, order.currency)} c/u</p>
                  </div>
                  <p class="text-[15px] font-bold text-foreground">×{item.quantity}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Columna lateral -->
      <div class="space-y-4">

        <div class="overflow-hidden rounded-xl border border-border">
          <div class="bg-foreground px-4 py-3.5">
            <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-background">
              {esRecoger ? 'Recoge en' : 'Enviar a'}
            </p>
          </div>
          <div class="p-4">
            {esRecoger ? (
              <p class="text-[13px] leading-relaxed text-muted-foreground">{direccionSucursal || 'Sucursal no registrada'}</p>
            ) : (
              <div>
                <p class="mb-1.5 text-sm font-semibold text-foreground">{order.customer_name}</p>
                <p class="text-[13px] leading-relaxed text-muted-foreground">{order.shipping_address || 'Sin dirección registrada'}</p>
              </div>
            )}
            {order.customer_phone && (
              <p class="mt-3 text-[13px] text-muted-foreground">{order.customer_phone}</p>
            )}
          </div>
        </div>

        {requiereFactura ? (
          <div class="overflow-hidden rounded-xl border border-amber-200 bg-amber-50">
            <div class="border-b border-amber-200 px-4 py-3.5">
              <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-amber-800">Requiere factura</p>
            </div>
            <div class="space-y-2.5 p-4">
              {billingFields.map((field) => (
                <div class="flex justify-between gap-3">
                  <span class="text-xs text-amber-900">{field.label}</span>
                  <span class="text-right text-[13px] font-semibold text-foreground">{field.value}</span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="rounded-xl border border-border p-4">
            <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-muted-foreground">Facturación</p>
            <p class="text-[13px] leading-relaxed text-muted-foreground">Este pedido no solicitó factura.</p>
          </div>
        )}

        <div class="rounded-xl border border-border p-4">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.12em] text-muted-foreground">Resumen</p>
          <div class="space-y-2.5">
            <div class="flex justify-between">
              <span class="text-[13px] text-muted-foreground">Productos</span>
              <span class="text-[13px] text-foreground">{formatCurrency(subtotal, order.currency)}</span>
            </div>
            <div class="flex justify-between border-t border-border pt-2.5">
              <span class="text-sm font-bold text-foreground">Total cobrado</span>
              <span class="text-sm font-bold text-foreground">{formatCurrency(order.total_amount, order.currency)}</span>
            </div>
          </div>
          <p class="mt-3 text-xs text-muted-foreground">Creada el {formatDate(order.created_at)}</p>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
