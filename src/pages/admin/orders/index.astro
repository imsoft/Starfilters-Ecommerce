---
import AdminLayout from "@/layouts/adminLayout.astro";
import { Button } from "@/components/ui/button";
import AdminFilters from "@/components/shared/AdminFilters.astro";
import CustomModal from "@/components/shared/CustomModal.astro";
import { getOrders, getOrderItems } from "@/lib/database";
import type { Order, OrderItem } from "@/lib/database";
import { getDeliveryLabel, isPickupMethod } from "@/lib/delivery-options";
import { ESTADOS, infoEstado } from "@/lib/order-status-ui";
import type { DeliveryMethod } from "@/lib/delivery-options";

import { requireAdmin } from "@/lib/auth-utils";

// Solo administradores: esta página se podía abrir sin haber iniciado sesión.
const { redirect: redirigirSiNoEsAdmin } = await requireAdmin(Astro.cookies);
if (redirigirSiNoEsAdmin) {
  return Astro.redirect(redirigirSiNoEsAdmin);
}

// Obtener todas las órdenes con logs para debug y manejo de errores
let allOrders: Order[] = [];

try {
  console.log('🔍 Obteniendo órdenes desde la base de datos...');
  allOrders = await getOrders(100, 0) as Order[];
  console.log('📋 Órdenes obtenidas:', allOrders.length);
  console.log('📋 Datos de órdenes:', allOrders);
} catch (error) {
  console.error('❌ Error obteniendo órdenes:', error);
  allOrders = [];
}

// Estadísticas
const totalOrders = allOrders.length;
const pendingOrders = allOrders.filter(order => order.status === 'pending').length;
const processingOrders = allOrders.filter(order => order.status === 'processing').length;
const completedOrders = allOrders.filter(order => order.status === 'delivered').length;

console.log('📊 Estadísticas de órdenes calculadas:', {
  totalOrders,
  pendingOrders,
  processingOrders,
  completedOrders
});

// Función para formatear fecha
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(date);
}

// Función para formatear moneda
// Los pedidos pueden estar en pesos o en dólares (el sitio en inglés cobra en
// USD), así que el importe se formatea con la moneda de cada orden.
function formatCurrency(amount: number, currency: string = 'MXN'): string {
  const moneda = currency === 'USD' ? 'USD' : 'MXN';
  return new Intl.NumberFormat(moneda === 'USD' ? 'en-US' : 'es-MX', {
    style: 'currency',
    currency: moneda,
  }).format(amount) + ` ${moneda}`;
}

// El color y la etiqueta del estado vienen de order-status-ui, la misma fuente
// que usa el detalle: antes esta pantalla decía "En Proceso" y la otra "En
// preparación" para el mismo estado.
const getStatusColor = (status: string) => infoEstado(status).badge;
const getStatusText = (status: string) => infoEstado(status).etiqueta;

// Obtener conteo de productos para todas las órdenes con manejo de errores mejorado
const orderProductCounts = new Map<number, number>();
console.log('🔍 Obteniendo items de órdenes...');

for (const order of allOrders) {
  try {
    const items = await getOrderItems(order.id);
    orderProductCounts.set(order.id, items.length);
    console.log(`📦 Orden ${order.id}: ${items.length} items`);
  } catch (error) {
    console.error(`❌ Error obteniendo productos de la orden ${order.id}:`, error);
    orderProductCounts.set(order.id, 0);
  }
}

console.log('📊 Conteo de productos por orden:', Object.fromEntries(orderProductCounts));

// --- Bandeja de trabajo -----------------------------------------------------
// La lista se ordenaba por fecha, así que un pedido de hoy sin preparar
// aparecía debajo de uno entregado la semana pasada. Ahora manda el trabajo
// pendiente: primero lo que nadie ha tocado, y dentro de eso lo más viejo.
const PRIORIDAD: Record<string, number> = {
  pending: 0,
  processing: 1,
  shipped: 2,
  delivered: 3,
  cancelled: 4,
};

const DIA_MS = 24 * 60 * 60 * 1000;
const ahora = Date.now();

// Días que lleva la orden sin cambiar de estado. No es el plazo prometido al
// cliente (los tiempos de entrega son texto libre y no se pueden calcular),
// sino una señal honesta de que ahí nadie ha movido nada.
const diasSinAvanzar = (order: Order): number => {
  const referencia = order.updated_at || order.created_at;
  if (!referencia) return 0;
  return Math.floor((ahora - new Date(referencia).getTime()) / DIA_MS);
};

const DIAS_PARA_ALERTA = 2;

const ordersEnriquecidas = allOrders
  .map((order) => {
    const metodo = (order.delivery_method || null) as DeliveryMethod | null;
    const enCurso = order.status === 'pending' || order.status === 'processing';
    const dias = diasSinAvanzar(order);
    return {
      order,
      // Las órdenes anteriores a esta versión no tienen forma de entrega.
      etiquetaEntrega: metodo ? getDeliveryLabel(metodo) : null,
      esRecoger: metodo ? isPickupMethod(metodo) : false,
      requiereFactura: Boolean(order.billing_data),
      diasSinAvanzar: dias,
      estancada: enCurso && dias >= DIAS_PARA_ALERTA,
    };
  })
  .sort((a, b) => {
    const porEstado = (PRIORIDAD[a.order.status] ?? 9) - (PRIORIDAD[b.order.status] ?? 9);
    if (porEstado !== 0) return porEstado;
    // Dentro del mismo estado, lo más viejo primero: es lo que urge.
    return new Date(a.order.created_at).getTime() - new Date(b.order.created_at).getTime();
  });

// Opciones del modal de estado, desde la fuente única.
const opcionesEstado = Object.entries(ESTADOS).map(([clave, info]) => ({
  clave,
  etiqueta: info.etiqueta,
  significa: info.significa,
}));

const porPreparar = allOrders.filter((o) => o.status === 'pending' || o.status === 'processing').length;
const enTransito = allOrders.filter((o) => o.status === 'shipped').length;
const estancadas = ordersEnriquecidas.filter((o) => o.estancada).length;
---

<AdminLayout title="Gestión de Órdenes">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mt-10 mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Gestión de Órdenes</h1>
            <p class="mt-2 text-muted-foreground">
              Administra todas las órdenes y pedidos de tu tienda
            </p>
          </div>
          <a href="/admin/dashboard">
            <Button variant="outline" className="border-border text-foreground hover:bg-muted">
              <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              Volver al Dashboard
            </Button>
          </a>
        </div>
      </div>

      <!-- Contadores: además de informar, filtran la tabla al hacer clic.
           Miden trabajo pendiente, no totales históricos. -->
      <div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-5">
        <button type="button" data-contador data-status="" class="rounded-lg border-2 border-primary bg-primary/5 p-4 text-left transition-colors hover:bg-muted">
          <p class="mb-1.5 text-sm font-semibold text-foreground">Todas</p>
          <p class="text-2xl font-bold text-foreground">{totalOrders}</p>
        </button>
        <button type="button" data-contador data-status="pending" class="rounded-lg border border-border bg-background p-4 text-left transition-colors hover:bg-muted">
          <p class="mb-1.5 text-sm font-semibold text-muted-foreground">Por preparar</p>
          <p class="text-2xl font-bold text-foreground">{porPreparar}</p>
        </button>
        <button type="button" data-contador data-status="shipped" class="rounded-lg border border-border bg-background p-4 text-left transition-colors hover:bg-muted">
          <p class="mb-1.5 text-sm font-semibold text-muted-foreground">En tránsito</p>
          <p class="text-2xl font-bold text-foreground">{enTransito}</p>
        </button>
        <button type="button" data-contador data-status="delivered" class="rounded-lg border border-border bg-background p-4 text-left transition-colors hover:bg-muted">
          <p class="mb-1.5 text-sm font-semibold text-muted-foreground">Entregadas</p>
          <p class="text-2xl font-bold text-foreground">{completedOrders}</p>
        </button>
        <div class={`rounded-lg border p-4 ${estancadas > 0 ? 'border-red-200 bg-red-50' : 'border-border bg-background'}`}>
          <p class={`mb-1.5 text-sm font-semibold ${estancadas > 0 ? 'text-red-800' : 'text-muted-foreground'}`}>Sin avanzar +2 días</p>
          <p class={`text-2xl font-bold ${estancadas > 0 ? 'text-red-800' : 'text-foreground'}`}>{estancadas}</p>
        </div>
      </div>

      <!-- Filtros y búsqueda -->
      <AdminFilters
        searchPlaceholder="Buscar por número de orden o cliente..."
        searchId="search-orders"
        filters={[
          {
            id: "status-filter-orders",
            label: "Todos los estados",
            options: [
              { value: "pending", label: "Pendiente" },
              { value: "processing", label: "En Proceso" },
              { value: "shipped", label: "Enviado" },
              { value: "delivered", label: "Entregado" },
              { value: "cancelled", label: "Cancelado" }
            ]
          },
          {
            id: "date-filter-orders",
            label: "Últimos 30 días",
            options: [
              { value: "today", label: "Hoy" },
              { value: "week", label: "Esta semana" },
              { value: "month", label: "Este mes" },
              { value: "year", label: "Este año" }
            ]
          }
        ]}
      />

      <!-- Tabla de órdenes -->
      <div class="rounded-lg border border-border bg-background">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-muted">
              <tr>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Orden</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Cliente</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Fecha</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Total</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Entrega</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Factura</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Estado</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody id="orders-table-body" class="divide-y divide-border">
              {allOrders.length === 0 ? (
                <tr>
                  <td colspan="8" class="px-6 py-12 text-center">
                    <div class="flex flex-col items-center">
                      <svg class="h-12 w-12 text-muted-foreground mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      <h3 class="text-lg font-medium text-foreground mb-2">No hay órdenes</h3>
                      <p class="text-muted-foreground">No se han encontrado órdenes en el sistema.</p>
                    </div>
                  </td>
                </tr>
              ) : (
                ordersEnriquecidas.map(({ order, etiquetaEntrega, esRecoger, requiereFactura, estancada, diasSinAvanzar }) => (
                  <tr
                    class="hover:bg-muted/50"
                    data-order-row
                    data-status={order.status}
                    data-buscar={`${order.order_number} ${order.customer_name} ${order.customer_email}`.toLowerCase()}
                  >
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <span class="text-sm font-medium text-foreground">{order.order_number}</span>
                        {estancada && (
                          <span class="rounded bg-red-100 px-1.5 py-0.5 text-[11px] font-bold text-red-800" title="Lleva días sin cambiar de estado">
                            {diasSinAvanzar} d
                          </span>
                        )}
                      </div>
                      <div class="text-sm text-muted-foreground">
                        {orderProductCounts.get(order.id) || 0} producto{(orderProductCounts.get(order.id) || 0) !== 1 ? 's' : ''}
                      </div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <div class="text-sm font-medium text-foreground">{order.customer_name}</div>
                      <div class="text-sm text-muted-foreground">{order.customer_email}</div>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-sm text-foreground">
                      {formatDate(order.created_at)}
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-sm font-medium text-foreground">
                      {formatCurrency(order.total_amount, order.currency)}
                    </td>
                    <td class="px-3 py-4">
                      {etiquetaEntrega ? (
                        <div class="flex items-start gap-2">
                          {esRecoger ? (
                            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"></path>
                            </svg>
                          ) : (
                            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M16 3h1.7a2 2 0 0 1 1.8 1.1L21 8v8h-2M3 8h13v8H9"></path>
                              <circle cx="7" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle>
                            </svg>
                          )}
                          <div>
                            <div class="text-sm text-foreground">{etiquetaEntrega}</div>
                            {order.tracking_number && (
                              <div class="text-xs text-muted-foreground">Guía {order.tracking_number}</div>
                            )}
                          </div>
                        </div>
                      ) : (
                        <span class="text-sm text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      {requiereFactura ? (
                        <span class="inline-flex rounded-md bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-800">Sí</span>
                      ) : (
                        <span class="text-sm text-muted-foreground">No</span>
                      )}
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap">
                      <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getStatusColor(order.status)}`}>
                        {getStatusText(order.status)}
                      </span>
                    </td>
                    <td class="px-3 py-4 whitespace-nowrap text-sm font-medium">
                      <div class="flex space-x-1">
                        <a href={`/admin/orders/${order.uuid}`}>
                          <Button variant="outline" size="sm" className="border-border text-foreground hover:bg-muted" title="Ver detalles">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                          </Button>
                        </a>
                        <button
                          type="button"
                          class="change-status-btn inline-flex items-center justify-center rounded-md text-sm font-semibold ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-primary bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3 gap-2 shadow-sm"
                          data-order-id={order.id}
                          data-order-number={order.order_number}
                          data-current-status={order.status}
                          title="Cambiar estado"
                        >
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                          </svg>

                        </button>
                        <button
                          type="button"
                          class="delete-order-button inline-flex items-center justify-center rounded-md text-sm font-semibold ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-red-600 bg-red-600 text-white hover:bg-red-700 h-8 px-3 gap-2 shadow-sm"
                          data-order-id={order.id}
                          data-order-number={order.order_number}
                          title="Eliminar orden"
                        >
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <!-- Paginación -->
        {allOrders.length > 0 && (
          <div class="px-6 py-4 border-t border-border">
            <div class="flex items-center justify-between">
              <div class="text-sm text-muted-foreground">
                Mostrando <span class="font-medium text-foreground">{allOrders.length}</span> orden{allOrders.length !== 1 ? 'es' : ''}
              </div>
              <div class="flex items-center space-x-2">
                <Button variant="outline" size="sm" className="border-border text-foreground hover:bg-muted" disabled>
                  Anterior
                </Button>
                <Button variant="outline" size="sm" className="border-border hover:bg-muted bg-primary text-primary-foreground">
                  1
                </Button>
                <Button variant="outline" size="sm" className="border-border text-foreground hover:bg-muted" disabled>
                  Siguiente
                </Button>
              </div>
            </div>
          </div>
        )}
      </div>
  </div>

  <!-- Modal para cambiar estado -->
  <div
    id="status-dialog"
    class="fixed inset-0 z-50 hidden items-center justify-center"
    style="display: none;"
  >
    <!-- Overlay -->
    <div
      id="status-dialog-overlay"
      class="fixed inset-0 bg-black/80 backdrop-blur-sm"
    ></div>
    
    <!-- Modal Content -->
    <div
      id="status-dialog-content"
      class="relative z-50 mx-4 w-full max-w-md rounded-lg border border-border bg-background p-6 shadow-lg"
    >
      <div class="space-y-4">
        <h2 class="text-lg font-semibold text-foreground">Cambiar Estado de Orden</h2>
        <p id="dialog-order-info" class="text-sm text-muted-foreground"></p>
        
        <form id="status-form" method="POST" class="space-y-4">
          <input type="hidden" name="action" value="change_status" />
          <input type="hidden" name="orderId" id="dialog-order-id" />
          
          <div>
            <label class="block text-sm font-medium text-foreground mb-2">Nuevo estado</label>
            <select
              name="newStatus"
              id="dialog-new-status"
              class="w-full rounded-md border border-border bg-background px-3 py-2 text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              required
            >
              {opcionesEstado.map((opcion) => (
                <option value={opcion.clave} data-significa={opcion.significa}>{opcion.etiqueta}</option>
              ))}
            </select>
            <!-- Qué significa el estado elegido: cinco opciones sin explicación
                 obligaban a adivinar la diferencia entre "Pendiente" y "En
                 preparación". -->
            <p id="dialog-status-help" class="mt-2 text-xs text-muted-foreground"></p>
          </div>

          <label class="flex items-start gap-2.5 text-sm text-foreground">
            <input type="checkbox" id="dialog-notify" checked class="mt-0.5 h-4 w-4 rounded border-border text-primary focus:ring-primary" />
            <span>
              Avisar por correo
              <span class="block text-xs text-muted-foreground">Al cliente y a los correos de notificaciones. Desmárcalo si solo estás corrigiendo.</span>
            </span>
          </label>

          <div class="flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2 gap-2">
            <button
              type="button"
              id="status-dialog-cancel"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
            >
              Cancelar
            </button>
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-white hover:bg-primary/90 h-10 px-4 py-2"
            >
              Cambiar Estado
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Filtros de órdenes.
  //
  // Antes esto leía las celdas por posición (td:nth-child(6) para el estado) y
  // los índices ya no coincidían con la tabla: filtrar por estado escondía
  // todas las filas. Ahora cada fila lleva sus datos en atributos, así que
  // agregar o mover columnas no vuelve a romperlo.
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-orders');
    const statusFilter = document.getElementById('status-filter-orders');
    const tableBody = document.getElementById('orders-table-body');
    if (!tableBody) return;

    function filterOrders() {
      const searchTerm = (searchInput && searchInput.value ? searchInput.value : '').toLowerCase().trim();
      const selectedStatus = statusFilter && statusFilter.value ? statusFilter.value : '';

      const rows = tableBody.querySelectorAll('[data-order-row]');
      rows.forEach((row) => {
        const buscar = row.getAttribute('data-buscar') || '';
        const estado = row.getAttribute('data-status') || '';

        // "Por preparar" agrupa dos estados: nadie separa mentalmente
        // "pendiente" de "en proceso" cuando lo que quiere es surtir.
        const coincideEstado = !selectedStatus
          || estado === selectedStatus
          || (selectedStatus === 'pending' && estado === 'processing');

        const coincideBusqueda = searchTerm === '' || buscar.includes(searchTerm);

        row.style.display = coincideEstado && coincideBusqueda ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterOrders);
    statusFilter?.addEventListener('change', filterOrders);

    // Los contadores de arriba filtran al hacer clic.
    const contadores = document.querySelectorAll('[data-contador]');
    contadores.forEach((boton) => {
      boton.addEventListener('click', () => {
        const estado = boton.getAttribute('data-status') || '';
        if (statusFilter) {
          statusFilter.value = estado;
        }
        contadores.forEach((otro) => {
          const activo = otro === boton;
          otro.classList.toggle('border-2', activo);
          otro.classList.toggle('border-primary', activo);
          otro.classList.toggle('bg-primary/5', activo);
          otro.classList.toggle('border', !activo);
          otro.classList.toggle('border-border', !activo);
          otro.classList.toggle('bg-background', !activo);
        });
        filterOrders();
      });
    });
  });
</script>

<script>
  // Manejar cambio de estado
  document.addEventListener('DOMContentLoaded', () => {
    const dialogOrderInfo = document.getElementById('dialog-order-info');
    const dialogOrderId = document.getElementById('dialog-order-id') as HTMLInputElement;
    const dialogNewStatus = document.getElementById('dialog-new-status') as HTMLSelectElement;
    const statusForm = document.getElementById('status-form') as HTMLFormElement;

    // Abrir modal al hacer clic en botón de cambiar estado
    document.querySelectorAll('.change-status-btn').forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        console.log('🔘 Botón clickeado');
        
        const orderId = button.getAttribute('data-order-id');
        const orderNumber = button.getAttribute('data-order-number');
        const currentStatus = button.getAttribute('data-current-status');

        console.log('📋 Datos:', { orderId, orderNumber, currentStatus });

        if (orderId && orderNumber && currentStatus && dialogOrderInfo && dialogOrderId && dialogNewStatus) {
          dialogOrderInfo.textContent = `Orden: ${orderNumber}`;
          dialogOrderId.value = orderId;
          dialogNewStatus.value = currentStatus;
          actualizarAyuda();
          console.log('✅ Abriendo modal');
          
          // Mostrar modal personalizado
          const modal = document.getElementById('status-dialog');
          if (modal) {
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
          }
        } else {
          console.error('❌ Faltan datos o elementos del modal');
        }
      });
    });

    console.log(`✅ ${document.querySelectorAll('.change-status-btn').length} botones de cambio de estado encontrados`);

    const ayuda = document.getElementById('dialog-status-help');
    function actualizarAyuda() {
      if (!ayuda || !dialogNewStatus) return;
      const opcion = dialogNewStatus.selectedOptions[0];
      ayuda.textContent = opcion?.getAttribute('data-significa') || '';
    }
    dialogNewStatus?.addEventListener('change', actualizarAyuda);

    // Cerrar modal
    const dialogCancel = document.getElementById('status-dialog-cancel');
    const overlay = document.getElementById('status-dialog-overlay');
    
    const closeModal = () => {
      const modal = document.getElementById('status-dialog');
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    };

    dialogCancel?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', closeModal);

    // Cerrar con ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = document.getElementById('status-dialog');
        if (modal && modal.style.display === 'flex') {
          closeModal();
        }
      }
    });

    // Manejar envío del formulario
    statusForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(statusForm);
      const orderId = formData.get('orderId');
      const newStatus = formData.get('newStatus');

      if (!orderId || !newStatus) return;

      try {
        const response = await fetch('/api/orders/update-status', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            orderId: parseInt(orderId as string),
            status: newStatus,
            notify: (document.getElementById('dialog-notify') as HTMLInputElement)?.checked ?? true
          })
        });

        if (response.ok) {
          const modal = document.getElementById('status-dialog');
          if (modal) {
            modal.style.display = 'none';
            document.body.style.overflow = '';
          }
          window.location.reload();
        } else {
          alert('Error al actualizar el estado de la orden');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error al actualizar el estado de la orden');
      }
    });
  });
</script>

<script>
  // Manejar eliminación de órdenes
  document.addEventListener('DOMContentLoaded', () => {
    // deleteButtons nunca se declaró: el script reventaba con un ReferenceError
    // en cuanto cargaba la página y el botón de borrar no hacía nada.
    const deleteButtons = document.querySelectorAll('.delete-order-button');

    deleteButtons.forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        
        const btn = event.currentTarget as HTMLButtonElement;
        const orderId = btn.dataset.orderId;
        const orderNumber = btn.dataset.orderNumber || 'esta orden';
        
        if (!orderId) {
          alert('Error: ID de orden no encontrado');
          return;
        }

        // Confirmar eliminación
        if (!confirm(`¿Estás seguro de que quieres eliminar la orden ${orderNumber}? Esta acción no se puede deshacer y eliminará todos los items relacionados.`)) {
          return;
        }

        try {
          const response = await fetch(`/api/orders/${orderId}`, {
            method: 'DELETE',
            credentials: 'include',
          });

          const result = await response.json();

          if (response.ok && result.success) {
            alert('Orden eliminada exitosamente');
            window.location.reload();
          } else {
            alert(`Error: ${result.message || 'No se pudo eliminar la orden'}`);
          }
        } catch (error) {
          console.error('Error eliminando orden:', error);
          alert('Error al eliminar la orden. Por favor, intenta de nuevo.');
        }
      });
    });
  });
</script>

